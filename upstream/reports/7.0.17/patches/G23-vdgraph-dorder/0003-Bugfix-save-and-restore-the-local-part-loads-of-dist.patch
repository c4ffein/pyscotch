@@ -150,6 +152,9 @@ const VdgraphStore * const  storptr)
   grafptr->compglbsize[0] = storptr->compglbsize0;
   grafptr->compglbsize[1] = grafptr->s.vertglbnbr - (storptr->compglbsize0 + storptr->fronglbnbr);

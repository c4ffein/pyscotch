+  grafptr->complocload[0] = storptr->complocload[0];
+  grafptr->complocload[1] = storptr->complocload[1];
+  grafptr->complocload[2] = grafptr->s.velolocsum - (storptr->complocload[0] + storptr->complocload[1]);
   grafptr->complocsize[0] = storptr->complocsize0;
   grafptr->complocsize[1] = grafptr->s.vertlocnbr - (storptr->complocsize0 + storptr->fronlocnbr);

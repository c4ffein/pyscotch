 src/check/Makefile             |  1 +
 src/libscotch/dorder_io.c      | 12 +++++++-----
 src/libscotch/dorder_io_tree.c | 20 +++++++++++---------
 4 files changed, 22 insertions(+), 15 deletions(-)


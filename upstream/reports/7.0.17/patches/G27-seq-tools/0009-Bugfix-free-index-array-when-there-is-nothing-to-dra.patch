From b23f88680bc6e39b3f10154777d21c7c309750ea Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 16:08:12 +0000
Subject: [PATCH 09/11] Bugfix: free index array when there is nothing to draw
 in `gout` [report PyScotch]

The Inventor and VTK writers returned without freeing their path
index array when the graph has no edge to draw.
---
 src/scotch/gout_o.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/src/scotch/gout_o.c b/src/scotch/gout_o.c
index b761f8d..f32d264 100644
--- a/src/scotch/gout_o.c
+++ b/src/scotch/gout_o.c
@@ -363,8 +363,10 @@ FILE * const                fileptr)              /* Output stream
   fprintf (fileptr, "#Creator: Scotch/gout\n");
   fprintf (fileptr, "#CreationDate: %s", ctime (&timedat));
 
-  if (indxnbr == 0)                               /* If nothing to write */
-    return (0);
+  if (indxnbr == 0) {                             /* If nothing to write */
+    memFree (indxtab);                            /* Free group leader   */
+    return  (0);
+  }
 
   fprintf (fileptr, "Separator {\n");
   fprintf (fileptr, "  LightModel {\n    model\t\tBASE_COLOR\n  }\n");
@@ -1153,8 +1155,10 @@ FILE * const                fileptr)              /* Output stream
            C_filenamesrcinp, C_filenamegeoinp, C_filenamemapinp,
            ctime (&timedat));
 
-  if (indxnbr == 0)                               /* If nothing to write */
-    return (0);
+  if (indxnbr == 0) {                             /* If nothing to write */
+    memFree (indxtab);                            /* Free group leader   */
+    return  (0);
+  }
 
   fprintf (fileptr, "\nDATASET UNSTRUCTURED_GRID\n");
 
-- 

+/************************************************************/
+/**                                                        **/
+/**   NAME       : test_scotch_graph_map_view.c            **/
+/**                                                        **/
+/**   AUTHOR     : Francois PELLEGRINI                     **/
+/**                                                        **/
+/**   FUNCTION   : This module tests the operation of      **/
+/**                the SCOTCH_graphMapView() and           **/
+/**                SCOTCH_graphRemapView() routines on a   **/
+/**                path graph with known statistics.       **/
+/**                                                        **/
+/**   DATES      : # Version 7.0  : from : 13 oct 2026     **/
+/**                                 to   : 13 oct 2026     **/
+/**                                                        **/
+/************************************************************/
+
+/*
+**  The defines and includes.
+*/
+
+#include <stdio.h>
+#if (((defined __STDC_VERSION__) && (__STDC_VERSION__ >= 199901L)) || (defined HAVE_STDINT_H))
+#include <stdint.h>
+#endif /* (((defined __STDC_VERSION__) && (__STDC_VERSION__ >= 199901L)) || (defined HAVE_STDINT_H)) */
+#include <stdlib.h>
+#include <string.h>
+
+#include "../libscotch/module.h"
+#include "../libscotch/common.h"
+
+#include "scotch.h"
+
+#define VERTNBR                     8             /* Number of vertices in path graph */
+#define LINENBR                     32            /* Maximum number of lines in view  */
+#define LINESIZ                     256
+
+/*************************************/
+/*                                   */
+/* The consistency checking routine. */
+/*                                   */
+/*************************************/
+
+/* This routine checks that the line
+** of the given view that starts with
+** the given key has the expected value.
+** It exits on error.
+*/
+
+static
+void
+checkLine (
+char                        linetab[LINENBR][LINESIZ],
+const int                   linenbr,
+const char * const          keyptr,
+const char * const          valuptr)
+{
+  int                 linenum;
+
+  for (linenum = 0; linenum < linenbr; linenum ++) {
+    if (strncmp (linetab[linenum], keyptr, strlen (keyptr)) == 0) {
+      if (strcmp (linetab[linenum] + strlen (keyptr), valuptr) != 0) {
+        SCOTCH_errorPrint ("checkLine: invalid value for \"%s\": got \"%s\", expected \"%s\"", keyptr, linetab[linenum] + strlen (keyptr), valuptr);
+        exit (EXIT_FAILURE);
+      }
+      return;
+    }
+  }
+
+  SCOTCH_errorPrint ("checkLine: key \"%s\" not found", keyptr);
+  exit (EXIT_FAILURE);
+}
+
+/* This routine reads back the view
+** written to the given stream.
+** It returns the number of lines read.
+*/
+
+static
+int
+readView (
+FILE * const                stream,
+char                        linetab[LINENBR][LINESIZ])
+{
+  int                 linenbr;
+
+  rewind (stream);
+  for (linenbr = 0; (linenbr < LINENBR) && (fgets (linetab[linenbr], LINESIZ, stream) != NULL); linenbr ++)
+    linetab[linenbr][strlen (linetab[linenbr]) - 1] = '\0'; /* Remove trailing newline */
+  rewind (stream);
+
+  return (linenbr);
+}
+
+/*********************/
+/*                   */
+/* The main routine. */
+/*                   */
+/*********************/
+
+int
+main (
+int                 argc,
+char *              argv[])
+{
+  SCOTCH_Graph        grafdat;
+  SCOTCH_Arch         archdat;
+  SCOTCH_Mapping      mappdat;                    /* New mapping */
+  SCOTCH_Mapping      mapodat;                    /* Old mapping */
+  SCOTCH_Num          baseval;
+  SCOTCH_Num          verttab[VERTNBR + 1];
+  SCOTCH_Num          edgetab[2 * (VERTNBR - 1)];
+  SCOTCH_Num          parttab[VERTNBR];
+  SCOTCH_Num          parotab[VERTNBR];
+  SCOTCH_Num          vertnum;
+  SCOTCH_Num          edgenum;
+  FILE *              fileptr;
+  char                linetab[LINENBR][LINESIZ];
+  int                 linenbr;
+
+  SCOTCH_errorProg (argv[0]);
+
+  if (argc != 2) {
+    SCOTCH_errorPrint ("usage: %s base_value", argv[0]);
+    exit (EXIT_FAILURE);
+  }
+  baseval = (SCOTCH_Num) atoi (argv[1]);
+
+  for (vertnum = 0, edgenum = 0; vertnum < VERTNBR; vertnum ++) { /* Build path graph */
+    verttab[vertnum] = baseval + edgenum;
+    if (vertnum > 0)
+      edgetab[edgenum ++] = baseval + vertnum - 1;
+    if (vertnum < (VERTNBR - 1))
+      edgetab[edgenum ++] = baseval + vertnum + 1;
+  }
+  verttab[VERTNBR] = baseval + edgenum;
+
+  if (SCOTCH_graphInit (&grafdat) != 0) {         /* Initialize source graph */
+    SCOTCH_errorPrint ("main: cannot initialize graph");
+    exit (EXIT_FAILURE);
+  }
+  if (SCOTCH_graphBuild (&grafdat, baseval, VERTNBR, verttab, NULL, NULL, NULL, edgenum, edgetab, NULL) != 0) {
+    SCOTCH_errorPrint ("main: cannot build graph");
+    exit (EXIT_FAILURE);
+  }
+  if (SCOTCH_graphCheck (&grafdat) != 0) {
+    SCOTCH_errorPrint ("main: invalid graph");
+    exit (EXIT_FAILURE);
+  }
+
+  if (SCOTCH_archInit (&archdat) != 0) {          /* Target architecture is a line of eight processors */
+    SCOTCH_errorPrint ("main: cannot initialize architecture");
+    exit (EXIT_FAILURE);
+  }
+  if (SCOTCH_archMesh2 (&archdat, VERTNBR, 1) != 0) {
+    SCOTCH_errorPrint ("main: cannot build architecture");
+    exit (EXIT_FAILURE);
+  }
+
+  for (vertnum = 0; vertnum < VERTNBR; vertnum ++) { /* First half mapped on processor 0, second half on processor 7, and conversely */
+    parttab[vertnum] = (vertnum < (VERTNBR / 2)) ? 0 : (VERTNBR - 1);
+    parotab[vertnum] = (vertnum < (VERTNBR / 2)) ? (VERTNBR - 1) : 0;
+  }
+
+  if ((SCOTCH_graphMapInit (&grafdat, &mappdat, &archdat, parttab) != 0) ||
+      (SCOTCH_graphMapInit (&grafdat, &mapodat, &archdat, parotab) != 0)) {
+    SCOTCH_errorPrint ("main: cannot initialize mappings");
+    exit (EXIT_FAILURE);
+  }
+
+  if ((fileptr = tmpfile ()) == NULL) {           /* Open temporary file for resulting output */
+    SCOTCH_errorPrint ("main: cannot open file");
+    exit (EXIT_FAILURE);
+  }
+
+  if (SCOTCH_graphMapView (&grafdat, &mappdat, fileptr) != 0) {
+    SCOTCH_errorPrint ("main: cannot view mapping");
+    exit (EXIT_FAILURE);
+  }
+  linenbr = readView (fileptr, linetab);
+  checkLine (linetab, linenbr, "M\tProcessors ",  "2/8 (0.25)");
+  checkLine (linetab, linenbr, "M\tTarget ",      "min=4\tmax=4\tavg=4\tdlt=0\tmaxavg=1");
+  checkLine (linetab, linenbr, "M\tNeighbors ",   "min=1\tmax=1\tsum=2");
+  checkLine (linetab, linenbr, "M\tCommDilat=",   "1.000000\t(7)"); /* One cut edge of dilation 7, out of 7 edges */
+  checkLine (linetab, linenbr, "M\tCommLoad[7]=", "0.142857");
+  checkLine (linetab, linenbr, "M\tPartDiam\t",   "min=3\tmax=3\tavg=3.000000");
+
+  if (SCOTCH_graphRemapView (&grafdat, &mappdat, &mapodat, 1.0, NULL, fileptr) != 0) {
+    SCOTCH_errorPrint ("main: cannot view remapping");
+    exit (EXIT_FAILURE);
+  }
+  linenbr = readView (fileptr, linetab);
+  checkLine (linetab, linenbr, "M\tMigrNbr=",     "8(100.000000 %)");
+  checkLine (linetab, linenbr, "M\tAvgMigrDist=", "7.000000"); /* All vertices migrate from one end of the line to the other */
+  checkLine (linetab, linenbr, "M\tAvgMigrLoad=", "1.000000");
+  checkLine (linetab, linenbr, "M\tPartDiam\t",   "min=3\tmax=3\tavg=3.000000");
+
+  for (vertnum = 0; vertnum < VERTNBR; vertnum ++) { /* Part arrays must not have been modified by views */
+    if ((parttab[vertnum] != ((vertnum < (VERTNBR / 2)) ? 0 : (VERTNBR - 1))) ||
+        (parotab[vertnum] != ((vertnum < (VERTNBR / 2)) ? (VERTNBR - 1) : 0))) {
+      SCOTCH_errorPrint ("main: part arrays modified");
+      exit (EXIT_FAILURE);
+    }
+  }
+
+  parttab[0] = -1;                                /* First vertex is now unmapped */
+  if (SCOTCH_graphMapView (&grafdat, &mappdat, fileptr) != 0) {
+    SCOTCH_errorPrint ("main: cannot view partial mapping");
+    exit (EXIT_FAILURE);
+  }
+  linenbr = readView (fileptr, linetab);
+  checkLine (linetab, linenbr, "M\tProcessors ",  "2/8 (0.25)");
+  checkLine (linetab, linenbr, "M\tTarget ",      "min=3\tmax=4\tavg=3.5\tdlt=0.142857\tmaxavg=1.14286");
+  checkLine (linetab, linenbr, "M\tNeighbors ",   "min=1\tmax=1\tsum=2");
+  checkLine (linetab, linenbr, "M\tCommDilat=",   "1.000000\t(7)"); /* Edge (0,1) is no longer accounted for: 14 over 14 remaining arcs */
+  checkLine (linetab, linenbr, "M\tPartDiam\t",   "min=2\tmax=3\tavg=2.500000");
+
+  fclose (fileptr);
+
+  SCOTCH_graphMapExit (&grafdat, &mapodat);
+  SCOTCH_graphMapExit (&grafdat, &mappdat);
+  SCOTCH_archExit     (&archdat);
+  SCOTCH_graphExit    (&grafdat);
+
+  exit (EXIT_SUCCESS);
+}

From 0805bf80078f3b743d0d20102864e2cb254b7451 Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 13:58:52 +0000
Subject: [PATCH 8/9] Bugfix: report allocation failures in `graphCoarsen()`
 and free partially built coarse graph [report R. Perry]

`graphCoarsen2()` only tested the vertex array pointer of the coarse
graph to decide whether coarsening had succeeded. When the edge array
allocation failed in `graphCoarsen3()`, the freed vertex array pointer
was left dangling and 0 was returned, so that callers used a freed
graph; when a thread-local hash table allocation failed, the coarse
graph was never filled yet 0 was returned; when the matching queue
allocation failed, `graphCoarsenMatch()` returned 0 with an invalid
mating array. Several error paths also leaked the mating array, the
lock array and the hash tables of the other threads.

Initialize the coarse graph structure before launching the threads,
and let `graphCoarsen2()` act on the return value set by the threads:
on any failure, free the mating array if it was allocated locally,
free the coarse graph if its arrays had been allocated, and return
the error value. Free the thread-local hash tables and the lock array
on the threaded error paths.

Refs: GRA-14
---
 src/libscotch/graph_coarsen.c | 42 ++++++++++++++++++++++++-----------
 src/libscotch/graph_match.c   |  8 +++++--
 2 files changed, 35 insertions(+), 15 deletions(-)

diff --git a/src/libscotch/graph_coarsen.c b/src/libscotch/graph_coarsen.c
index 4436221..6c35805 100644
--- a/src/libscotch/graph_coarsen.c
+++ b/src/libscotch/graph_coarsen.c
@@ -1,4 +1,4 @@
-/* Copyright 2004,2007,2009,2011-2016,2018,2020,2021,2023 IPB, Universite de Bordeaux, INRIA & CNRS
+/* Copyright 2004,2007,2009,2011-2016,2018,2020,2021,2023,2026 IPB, Universite de Bordeaux, INRIA & CNRS
 **
 ** This file is part of the Scotch software package for static mapping,
 ** graph partitioning and sparse matrix ordering.
@@ -59,7 +59,7 @@
 /**                # Version 6.0  : from : 09 mar 2011     **/
 /**                                 to   : 29 apr 2019     **/
 /**                # Version 7.0  : from : 28 jul 2018     **/
-/**                                 to   : 19 jan 2023     **/
+/**                                 to   : 13 oct 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -240,8 +240,7 @@ GraphCoarsenData * restrict const coarptr)
     coarvendsiz = ((coarptr->flagval & GRAPHCOARSENNOCOMPACT) != 0) ? coarvertnbr : 1; /* TRICK: If not a compact graph, allocate a whole array for vendtab */
     coarmultsiz = ((coarptr->flagval & GRAPHCOARSENHASMULT)   == 0) ? coarvertnbr : 0; /* If coarmulttab is not user-provided, allocate it among graph data */
 
-    memSet (coargrafptr, 0, sizeof (Graph));      /* Initialize coarse graph on thread 0 */
-    coargrafptr->flagval = GRAPHFREEVERT | GRAPHVERTGROUP | GRAPHFREEEDGE;
+    coargrafptr->flagval = GRAPHFREEVERT | GRAPHVERTGROUP | GRAPHFREEEDGE; /* Fill coarse graph on thread 0 */
     coargrafptr->baseval = baseval;
     coargrafptr->vertnbr = coarvertnbr;
     coargrafptr->vertnnd = coarvertnbr + baseval;
@@ -253,8 +252,10 @@ GraphCoarsenData * restrict const coarptr)
                         &coarmulttab,          (size_t) (coarmultsiz * sizeof (GraphCoarsenMulti)), NULL) == NULL) ||
         ((coargrafptr->edgetax = memAlloc (finegrafptr->edgenbr * 2 * sizeof (Gnum))) == NULL)) { /* "* 2" for edlotab */
       errorPrint ("graphCoarsen3: out of memory (1)");
-      if (coargrafptr->verttax != NULL)
+      if (coargrafptr->verttax != NULL) {         /* If vertex arrays were allocated */
         memFree (coargrafptr->verttax);
+        coargrafptr->verttax = NULL;              /* Mark coarse graph as not built  */
+      }
       coarptr->retuval = 2;
 #ifdef GRAPHCOARSENNOTHREAD
 #ifdef SCOTCH_PTHREAD
@@ -383,8 +384,11 @@ GraphCoarsenData * restrict const coarptr)
   if (thrdnbr > 1) {                              /* If more than one thread                                      */
     threadBarrier (descptr);                      /* Ensure all of finecoartax has been written (or memory error) */
 
-    if (coarptr->retuval != 0)                    /* After barrier, in case memory allocation failed */
+    if (coarptr->retuval != 0) {                  /* After barrier, in case memory allocation failed */
+      if (thrdptr->coarhashtab != NULL)           /* Free local hash table if it was allocated      */
+        memFree (thrdptr->coarhashtab);
       return;
+    }
 
     if ((coarptr->flagval & GRAPHCOARSENNOCOMPACT) != 0) { /* If willing to have faster a non-compact graph */
       Gnum                coarvertnnd;
@@ -524,8 +528,11 @@ GraphCoarsenData * restrict const     coarptr)
     coarptr->flagval &= ~GRAPHCOARSENNOCOMPACT;   /* Non-compact graphs always imply more than one thread */
 
   if ((coarptr->flagval & GRAPHCOARSENUSEMATE) == 0) { /* If mating array not provided          */
-    if (graphMatchInit (coarptr, thrdnbr) != 0)   /* Initialize global data needed for matching */
+    if (graphMatchInit (coarptr, thrdnbr) != 0) { /* Initialize global data needed for matching */
+      if (finematetab != NULL)
+        memFree (finematetab);
       return (2);
+    }
   }
 
   if (coarptr->coarmulttab != NULL)               /* Record that multinode array was provided */
@@ -533,28 +540,37 @@ GraphCoarsenData * restrict const     coarptr)
 
   if ((coarptr->thrdtab = memAlloc (thrdnbr * sizeof (GraphCoarsenThread))) == NULL) {
     errorPrint ("graphCoarsen2: out of memory (2)");
+    if (((coarptr->flagval & GRAPHCOARSENUSEMATE) == 0) && /* If matching data were initialized */
+        (coarptr->finelocktax != NULL))
+      memFree (coarptr->finelocktax + baseval);
     if (finematetab != NULL)
       memFree (finematetab);
     return (2);
   }
   coarptr->retuval = 0;                           /* Assume no error */
 
+  if (coargrafptr != NULL)                        /* Initialize coarse graph so that its state is known on error */
+    memSet (coargrafptr, 0, sizeof (Graph));
+
   contextThreadLaunch (coarptr->contptr, (ThreadFunc) graphCoarsen3, (void *) coarptr);
 
   memFree (coarptr->thrdtab);
 
+  if (coarptr->retuval != 0) {                    /* If graph could not be coarsened or on error */
+    if (finematetab != NULL)                      /* Free mating array if it was allocated here  */
+      memFree (finematetab);
+    if ((coargrafptr != NULL) &&                  /* If coarse graph arrays had been allocated   */
+        (coargrafptr->verttax != NULL))
+      graphFree (coargrafptr);                    /* Free partially built coarse graph           */
+    return (coarptr->retuval);
+  }
+
   if ((coarptr->flagval & GRAPHCOARSENDSTMATE) == 0) /* If mating array destination not provided */
     memFree (finematetab);                        /* Do not keep mating data array               */
 
-  if (coarptr->coarvertnbr >= coarptr->coarvertmax) /* If coarsened graph is said to be too small, return here */
-    return (coarptr->retuval);
-
   if (coargrafptr == NULL)                        /* If coarse graph not wanted */
     return (0);
 
-  if (coargrafptr->verttax == NULL)               /* If graph could not be created */
-    return (coarptr->retuval);
-
 #ifdef SCOTCH_DEBUG_GRAPH2
   if (graphCheck (coargrafptr) != 0) {            /* Check graph consistency */
     errorPrint ("graphCoarsen2: inconsistent graph data");
diff --git a/src/libscotch/graph_match.c b/src/libscotch/graph_match.c
index a4ddde4..6b89b8c 100644
--- a/src/libscotch/graph_match.c
+++ b/src/libscotch/graph_match.c
@@ -1,4 +1,4 @@
-/* Copyright 2004,2007,2009,2011,2012,2015,2018-2021,2023 IPB, Universite de Bordeaux, INRIA & CNRS
+/* Copyright 2004,2007,2009,2011,2012,2015,2018-2021,2023,2026 IPB, Universite de Bordeaux, INRIA & CNRS
 **
 ** This file is part of the Scotch software package for static mapping,
 ** graph partitioning and sparse matrix ordering.
@@ -42,7 +42,7 @@
 /**   DATES      : # Version 6.0  : from : 05 oct 2012     **/
 /**                                 to   : 30 aug 2020     **/
 /**                # Version 7.0  : from : 28 jul 2018     **/
-/**                                 to   : 19 jan 2023     **/
+/**                                 to   : 13 oct 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -322,6 +322,10 @@ GraphCoarsenData * const          coarptr)        /* [norestrict] because of ret
     if (coarptr->retuval != 0) {
       if (thrdptr->finequeutab != NULL)           /* If someone else's allocation failed */
         memFree (thrdptr->finequeutab);           /* Free our own queue                  */
+#ifdef SCOTCH_PTHREAD
+      if (thrdnum == 0)                           /* Thread 0 frees now useless lock array */
+#endif /* SCOTCH_PTHREAD */
+        memFree (coarptr->finelocktax + coarptr->finegrafptr->baseval);
       return;
     }
   }

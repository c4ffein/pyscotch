From 5c4dddec05cb10c3f18dccd6c96d3fb434f29956 Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 13:34:57 +0000
Subject: [PATCH 1/8] Bugfix: size element bit array of `meshInduceSepa()`
 according to its word type [report PyScotch]

The array of element flags was made of `unsigned int` words but was
indexed with `INTSIZEBITS`, the bit width of `INT`. In 64-bit `Gnum`
builds, bits 32 to 63 of every word alias bits 0 to 31, so elements of
a same 64-element block are miscounted, the induced separator mesh is
allocated too small, and `SCOTCH_meshOrder()` crashes on a plain 32x32
quadrangle mesh (`mmk_m2 32 32 | mord`). Use `UINT` words, whose width
is `INTSIZEBITS`.

Add such a mesh to the `mmk`, `gmk_msh` and `mord` program checks.

Refs: PS2-G10-1
---
 src/check/CMakeLists.txt         |  8 +++++---
 src/check/Makefile               |  5 +++++
 src/libscotch/mesh_induce_sepa.c | 10 +++++-----
 3 files changed, 15 insertions(+), 8 deletions(-)

diff --git a/src/check/CMakeLists.txt b/src/check/CMakeLists.txt
index 09a83af..02187cd 100644
--- a/src/check/CMakeLists.txt
+++ b/src/check/CMakeLists.txt
@@ -582,11 +582,13 @@ add_test(NAME mmk_m2_5_4 COMMAND ${BASH} -c "'$<TARGET_FILE:mmk_m2>' 5 4 m2_5_4.
 
 add_test(NAME mmk_m3_5_4_3 COMMAND ${BASH} -c "'$<TARGET_FILE:mmk_m3>' 5 4 3 m3_5_4_3.msh && '$<TARGET_FILE:mtst>' m3_5_4_3.msh")
 
-set_tests_properties(mmk_m2_5_1 mmk_m2_5_4 mmk_m3_5_4_3 PROPERTIES FIXTURES_SETUP MMK_MESHES)
+add_test(NAME mmk_m2_32_32 COMMAND ${BASH} -c "'$<TARGET_FILE:mmk_m2>' 32 32 m2_32_32.msh && '$<TARGET_FILE:mtst>' m2_32_32.msh")
+
+set_tests_properties(mmk_m2_5_1 mmk_m2_5_4 mmk_m3_5_4_3 mmk_m2_32_32 PROPERTIES FIXTURES_SETUP MMK_MESHES)
 
 # check_prog_gmk_msh
 
-foreach(mmk_msh m2_5_1 m2_5_4 m3_5_4_3)
+foreach(mmk_msh m2_5_1 m2_5_4 m3_5_4_3 m2_32_32)
   add_test(NAME gmk_msh_${mmk_msh} COMMAND ${BASH} -c
     "'$<TARGET_FILE:gmk_msh>' ${mmk_msh}.msh ${mmk_msh}.grf && '$<TARGET_FILE:gtst>' ${mmk_msh}.grf")
   set_tests_properties(gmk_msh_${mmk_msh} PROPERTIES FIXTURES_REQUIRED MMK_MESHES FIXTURES_SETUP GMK_GRAPHS)
@@ -626,7 +628,7 @@ add_test(NAME mcv_pue_hb3 COMMAND ${BASH} -c
 
 # check_prog_mord
 
-foreach(mmk_msh m2_5_1 m2_5_4 m3_5_4_3)
+foreach(mmk_msh m2_5_1 m2_5_4 m3_5_4_3 m2_32_32)
   add_test(NAME mord_${mmk_msh} COMMAND ${BASH} -c "'$<TARGET_FILE:mord>' ${mmk_msh}.msh | '$<TARGET_FILE:gotst>' ${mmk_msh}.grf")
   set_tests_properties(mord_${mmk_msh} PROPERTIES FIXTURES_REQUIRED MMK_MESHES)
 endforeach()

+/* This routine builds a mesh made of disjoint
+** triangle elements, each of them having its
+** own three nodes. Elements are numbered first,
+** then nodes.
+** It returns:
+** - !NULL  : pointer to mesh data, to be freed after the mesh.
+** - NULL   : on error.
+*/
+
+static
+SCOTCH_Num *
+meshBuildDisj (
+SCOTCH_Mesh * const         meshptr,
+const SCOTCH_Num            velmnbr,              /*+ Number of elements +*/
+const SCOTCH_Num            baseval)
+{
+  SCOTCH_Num          vnodnbr;
+  SCOTCH_Num          velmnum;
+  SCOTCH_Num          vnodnum;
+  SCOTCH_Num          edgenbr;
+  SCOTCH_Num *        datatab;
+  SCOTCH_Num *        verttab;
+  SCOTCH_Num *        edgetab;
+
+  vnodnbr = 3 * velmnbr;
+  edgenbr = 6 * velmnbr;                          /* Three element-node edges per element, both ways */
+
+  if ((datatab = malloc ((velmnbr + vnodnbr + 1 + edgenbr) * sizeof (SCOTCH_Num))) == NULL)
+    return (NULL);
+  verttab = datatab;                              /* Compact vertex array for elements and nodes */
+  edgetab = verttab + (velmnbr + vnodnbr + 1);
+
+  for (velmnum = 0; velmnum < velmnbr; velmnum ++) { /* Elements have three private nodes */
+    verttab[velmnum] = baseval + 3 * velmnum;
+    edgetab[3 * velmnum]     = baseval + velmnbr + 3 * velmnum;
+    edgetab[3 * velmnum + 1] = baseval + velmnbr + 3 * velmnum + 1;
+    edgetab[3 * velmnum + 2] = baseval + velmnbr + 3 * velmnum + 2;
+  }
+  for (vnodnum = 0; vnodnum < vnodnbr; vnodnum ++) { /* Nodes have a single element neighbor */
+    verttab[velmnbr + vnodnum]     = baseval + 3 * velmnbr + vnodnum;
+    edgetab[3 * velmnbr + vnodnum] = baseval + vnodnum / 3;
+  }
+  verttab[velmnbr + vnodnbr] = baseval + edgenbr; /* Set end of compact vertex array */
+
+  if (SCOTCH_meshBuild (meshptr, baseval, baseval + velmnbr, velmnbr, vnodnbr, verttab, verttab + 1,
+                        NULL, NULL, NULL, edgenbr, edgetab) != 0) {
+    free (datatab);
+    return (NULL);
+  }
+
+  return (datatab);
+}
+
+/*******************************/
+/*                             */
+/* The mesh ordering routines. */
+/*                             */
+/*******************************/
 
 /* This routine orders the given mesh with the
 ** default strategy and checks the resulting
@@ -269,6 +322,43 @@ const char * const          nameptr)
   free (datatab);
 }
 
+/* This routine builds a mesh of disjoint elements,
+** orders it and checks the resulting ordering.
+** It exits on error.
+*/
+
+static
+void
+meshDisjTest (
+const SCOTCH_Num            velmnbr,              /*+ Number of elements        +*/
+const SCOTCH_Num            baseval,
+SCOTCH_Num * const          peritab,              /*+ Inverse permutation array +*/
+const char * const          nameptr)
+{
+  SCOTCH_Mesh         meshdat;
+  SCOTCH_Num *        datatab;
+
+  if (SCOTCH_meshInit (&meshdat) != 0) {
+    SCOTCH_errorPrint ("meshDisjTest: cannot initialize mesh");
+    exit (EXIT_FAILURE);
+  }
+
+  if ((datatab = meshBuildDisj (&meshdat, velmnbr, baseval)) == NULL) {
+    SCOTCH_errorPrint ("meshDisjTest: cannot build mesh (%s)", nameptr);
+    exit (EXIT_FAILURE);
+  }
+
+  if (SCOTCH_meshCheck (&meshdat) != 0) {
+    SCOTCH_errorPrint ("meshDisjTest: invalid mesh (%s)", nameptr);
+    exit (EXIT_FAILURE);
+  }
+
+  meshOrderTest (&meshdat, baseval, 3 * velmnbr, peritab, nameptr);
+
+  SCOTCH_meshExit (&meshdat);
+  free (datatab);
+}
+
 /*********************/
 /*                   */
 /* The main routine. */
@@ -304,6 +394,7 @@ char *              argv[])
   }
   meshGridTest (32, 1, 3, peritab, "grid with element and node loads");
   meshGridTest (32, 1, 0, peritab, "grid without loads");
+  meshDisjTest (30, 0, peritab, "disjoint triangles"); /* Compressed into isolated loaded nodes */
 

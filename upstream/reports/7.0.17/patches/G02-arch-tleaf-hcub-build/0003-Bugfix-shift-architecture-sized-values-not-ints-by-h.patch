+/* This routine builds the binary
+** hypercube architecture of the
+** given dimension.
+** It returns:
+** - 0   : if the architecture has been successfully built.
+** - !0  : on error.
+*/
+
+int
+archHcubArchBuild (
+ArchHcub * restrict const   archptr,
+const Anum                  dimnnbr)              /*+ Number of dimensions +*/
+{
+#ifdef SCOTCH_DEBUG_ARCH1
+  if ((sizeof (ArchHcub)    > sizeof (ArchDummy)) ||
+      (sizeof (ArchHcubDom) > sizeof (ArchDomDummy))) {
+    errorPrint ("archHcubArchBuild: invalid type specification");
+    return (1);
+  }
+#endif /* SCOTCH_DEBUG_ARCH1 */
+
+  if ((dimnnbr < 1) ||
+      (dimnnbr > (Anum) ((sizeof (Anum) << 3) - 2))) { /* Should have enough bits in ArchHcubDom bitsset field */
+    errorPrint ("archHcubArchBuild: invalid number of dimensions");
+    return (1);
+  }
+
+  archptr->dimnnbr = dimnnbr;
+
+  return (0);
+}

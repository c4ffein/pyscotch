@@ -444,7 +444,8 @@ SCOTCH_Num * const          treetab)              /*+ Column block range array
   SCOTCH_Ordering     ordedat;
   int                 o;
 
-  SCOTCH_graphOrderInit (grafptr, &ordedat, permtab, peritab, cblkptr, rangtab, treetab);

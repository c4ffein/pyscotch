+
+/*
+**  The defines and includes.
+*/
+
+#include <stdio.h>
+#if (((defined __STDC_VERSION__) && (__STDC_VERSION__ >= 199901L)) || (defined HAVE_STDINT_H))
+#include <stdint.h>
+#endif /* (((defined __STDC_VERSION__) && (__STDC_VERSION__ >= 199901L)) || (defined HAVE_STDINT_H)) */
+#include <stdlib.h>
+#include <string.h>
+
+#include "../libscotch/module.h"
+#include "../libscotch/common.h"
+
+#include "scotch.h"
+
+/*********************/
+/*                   */
+/* The main routine. */
+/*                   */
+/*********************/
+
+int
+main (
+int                 argc,
+char *              argv[])
+{
+  FILE *              fileptr;
+  FILE *              filegeoptr;
+  SCOTCH_Mesh         meshdat;
+  SCOTCH_Geom         geomdat;
+  SCOTCH_Num          dimnnbr;
+  double *            geomtab;
+
+  SCOTCH_errorProg (argv[0]);
+
+  if (argc != 4) {
+    SCOTCH_errorPrint ("usage: %s mesh_file geom_file out_geom_file", argv[0]);
+    exit (EXIT_FAILURE);
+  }
+
+  if (SCOTCH_meshInit (&meshdat) != 0) {          /* Initialize source mesh */
+    SCOTCH_errorPrint ("main: cannot initialize mesh");
+    exit (EXIT_FAILURE);
+  }
+  if (SCOTCH_geomInit (&geomdat) != 0) {          /* Initialize geometry */
+    SCOTCH_errorPrint ("main: cannot initialize geometry");
+    exit (EXIT_FAILURE);
+  }
+
+  if ((fileptr = fopen (argv[1], "r")) == NULL) {
+    SCOTCH_errorPrint ("main: cannot open file (1)");
+    exit (EXIT_FAILURE);
+  }
+  if ((filegeoptr = fopen (argv[2], "r")) == NULL) {
+    SCOTCH_errorPrint ("main: cannot open file (2)");
+    exit (EXIT_FAILURE);
+  }
+
+  if (SCOTCH_meshGeomLoadScot (&meshdat, &geomdat, fileptr, filegeoptr, NULL) != 0) { /* Read source mesh and geometry */
+    SCOTCH_errorPrint ("main: cannot load mesh");
+    exit (EXIT_FAILURE);
+  }
+
+  fclose (fileptr);
+  fclose (filegeoptr);
+
+  if (SCOTCH_meshCheck (&meshdat) != 0) {
+    SCOTCH_errorPrint ("main: invalid mesh");
+    exit (EXIT_FAILURE);
+  }
+
+  SCOTCH_geomData (&geomdat, &dimnnbr, &geomtab);
+  if ((dimnnbr < 1) || (geomtab == NULL)) {
+    SCOTCH_errorPrint ("main: invalid geometry data");
+    exit (EXIT_FAILURE);
+  }
+
+  if ((fileptr = fopen (argv[3], "w")) == NULL) {
+    SCOTCH_errorPrint ("main: cannot open file (3)");
+    exit (EXIT_FAILURE);
+  }
+
+  if (SCOTCH_meshGeomSaveScot (&meshdat, &geomdat, NULL, fileptr, NULL) != 0) { /* Write geometry back */
+    SCOTCH_errorPrint ("main: cannot save geometry");
+    exit (EXIT_FAILURE);
+  }
+
+  fclose (fileptr);
+
+  SCOTCH_geomExit (&geomdat);
+  SCOTCH_meshExit (&meshdat);
+
+  exit (EXIT_SUCCESS);
+}

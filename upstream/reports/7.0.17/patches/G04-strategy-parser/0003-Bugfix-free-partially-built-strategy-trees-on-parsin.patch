From 0dd12a8f39017891f8eb6c770fea6bc93e55671c Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 09:27:54 +0000
Subject: [PATCH 03/10] Bugfix: free partially built strategy trees on parsing
 error [report R. Perry]

Bison discards the semantic values of the symbols it pops during error
recovery and on `YYABORT`, but the grammar had no `%destructor`, so the
strategy and test sub-trees held by these values leaked. Method nodes
being built were only freed at the outermost level: the ones of
enclosing methods, saved by the mid-rule action of strategy-valued
parameters, were lost as well.

Add destructors for `<STRAT>` and `<TEST>` values, and make the
`<SAVE>` destructor free the method node being built before restoring
the enclosing one, so that `stratParserParse()` only has to free the
outermost node (or the completed tree). The manual frees that precede
`YYABORT` within actions remain necessary, as Bison does not destroy
the right-hand side of the rule being reduced; add the missing one to
the debug-mode internal error path.

Refs: COR-23
---
 src/libscotch/parser_yy.y | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/src/libscotch/parser_yy.y b/src/libscotch/parser_yy.y
index f34fd81..834e0e6 100644
--- a/src/libscotch/parser_yy.y
+++ b/src/libscotch/parser_yy.y
@@ -138,9 +138,16 @@ YY_DECL;                                          /* Definition of yylex(); Flex
 %type <STRAT>        STRATGROUP    STRATMETHOD   STRATSELECT
 
 %destructor {                                     /* Restore parser context when sub-strategy is discarded by error recovery */
+  stratExit (penvptr->straptr);                   /* Free discarded method node being built, if any                          */
   penvptr->straptr = ($$).strat;
   penvptr->paraptr = ($$).param;
 } <SAVE>
+%destructor {                                     /* Free partial strategy trees discarded by error recovery or abort */
+  stratExit ($$);
+} <STRAT>
+%destructor {
+  stratTestExit ($$);
+} <TEST>
 
 %start STRAT
 
@@ -479,6 +486,7 @@ PARAMVAL      : VALCASE
 #ifdef SCOTCH_DEBUG_PARSER2
                   if (((penvptr->paraptr->doffptr - penvptr->paraptr->dbasptr) + sizeof (Strat *)) > sizeof (StratNodeMethodData)) {
                     errorPrint ("stratParserParse: internal error (5)");
+                    stratExit  ($2);
                     YYABORT;
                   }
 #endif /* SCOTCH_DEBUG_PARSER2 */
@@ -829,8 +837,8 @@ const char * const          textptr)              /*+ Strategy string to parse
   stratParserLexBufDelete (buffdat, scandat);
   stratParserLexDestroy   (scandat);
 
-  if (o != 0) {
-    if (penvdat.straptr != NULL)
+  if (o != 0) {                                   /* On error, free method node being built or completed strategy tree */
+    if (penvdat.straptr != NULL)                  /* Partial trees held by the parser stack have already been freed    */
       stratExit (penvdat.straptr);
     return (NULL);
   }

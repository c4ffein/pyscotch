+      (vsiztab != NULL)) {
     const SCOTCH_Num * restrict vsiztax;
     Gnum                        vertnum;
     Gnum                        edgenum;
@@ -222,13 +231,11 @@ SCOTCH_Num * const          npart)                /*+ Node partition array to be
           epart[vertnum] += baseval;
       }
 
-      if ((vsiztab != NULL) ||                    /* If computation of communication volume wanted */

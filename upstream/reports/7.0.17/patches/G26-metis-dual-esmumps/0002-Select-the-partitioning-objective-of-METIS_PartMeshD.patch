-                                     (edlotab != NULL) ? (edlotab - baseval) : NULL, epart - baseval, objval);
+      else                                        /* Dual graph has no edge loads of its own */
+        o = _SCOTCH_METIS_OutputCut (baseval, vertnbr + baseval, verttab - baseval, edgetab - baseval, NULL, epart - baseval, objval);
     }
     SCOTCH_stratExit (&stradat);
   }

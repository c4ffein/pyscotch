         o = _SCOTCH_METIS_OutputVol (baseval, vertnbr + baseval, verttab - baseval, edgetab - baseval,
                                      (vsiztab != NULL) ? (vsiztab - baseval) : NULL, *nparts, epart - baseval, objval);
-      else

+/* checkSizes checks the separator tree sizes
+** returned by ParMETIS_V3_NodeND: when the number
+** of processes is a power of two, subdomain and
+** separator sizes must sum up to the number of
+** vertices; else, all values must be -1.
+** It exits on error.
+*/
+
+static
+void
+checkSizes (
+const SCOTCH_Num            vertglbnbr,
+const int                   procglbnbr,
+const SCOTCH_Num * const    sizetab)
+{
+  SCOTCH_Num          sizesum;
+  int                 procnum;
+  int                 bitsnbr;
+  int                 proctmp;
+
+  for (bitsnbr = 0, proctmp = procglbnbr; proctmp != 0; proctmp >>= 1) /* Count number of bits set to 1 in procglbnbr */
+    bitsnbr += proctmp & 1;
+
+  for (procnum = 0, sizesum = 0; procnum < (2 * procglbnbr - 1); procnum ++) {
+    if (bitsnbr != 1) {                           /* If number of processes is not a power of two */
+      if (sizetab[procnum] != -1) {
+        SCOTCH_errorPrint ("checkSizes: invalid size value (1)");
+        exit (EXIT_FAILURE);
+      }
+    }
+    else if (sizetab[procnum] < 0) {
+      SCOTCH_errorPrint ("checkSizes: invalid size value (2)");
+      exit (EXIT_FAILURE);
+    }
+    sizesum += sizetab[procnum];
+  }
+  if ((bitsnbr == 1) && (sizesum != vertglbnbr)) {
+    SCOTCH_errorPrint ("checkSizes: invalid size sum");
+    exit (EXIT_FAILURE);
+  }
+}
+
 /*********************/
 /*                   */
 /* The main routine. */
@@ -367,6 +409,7 @@ char *              argv[])
   }
 
   checkOrder (baseval, vertlocnbr, vertglbnbr, parttab, proccomm);
+  checkSizes (vertglbnbr, procglbnbr, sizetab);
 #endif /* (SCOTCH_METIS_VERSION == 3) */
 
   if (MPI_Barrier (proccomm) != MPI_SUCCESS) {    /* Synchronize for debug */

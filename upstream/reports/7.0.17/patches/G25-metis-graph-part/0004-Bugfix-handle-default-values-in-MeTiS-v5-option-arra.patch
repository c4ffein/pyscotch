 src/check/test_libmetis.c                  | 21 +++++++++
 src/libscotchmetis/Makefile                | 14 +++---
 src/libscotchmetis/metis_graph_order.c     | 11 +++--
 src/libscotchmetis/metis_graph_part.c      |  7 ++-
 src/libscotchmetis/metis_graph_part_dual.c | 13 +++---
 src/libscotchmetis/metis_options.c         | 37 +++++++++++++++-
 src/libscotchmetis/metis_options.h         | 51 ++++++++++++++++++++++
 7 files changed, 138 insertions(+), 16 deletions(-)
 create mode 100644 src/libscotchmetis/metis_options.h

diff --git a/src/check/test_libmetis.c b/src/check/test_libmetis.c
index ca0011a..c88dd9a 100644
--- a/src/check/test_libmetis.c
+++ b/src/check/test_libmetis.c
@@ -229,6 +229,7 @@ char *              argv[])
   SCOTCH_Num          partnum;
   SCOTCH_Num          vertnum;
   SCOTCH_Num          options[METIS_NOPTIONS];
+  int                 optinum;
 #endif /* (SCOTCH_METIS_VERSION == 5) */
 
   SCOTCH_errorProg (argv[0]);
@@ -380,6 +381,26 @@ char *              argv[])
   }
 
   checkOrder (baseval, vertnbr, parttab, peritab);
+
+  for (optinum = 0; optinum < METIS_NOPTIONS; optinum ++) /* MeTiS v5 callers fill option arrays with -1 to get default values */
+    options[optinum] = -1;
+  if (baseval != 0)                               /* Default numbering is from 0 */
+    options[METIS_OPTION_NUMBERING] = baseval;
+
+  if (SCOTCHMETISNAMEC (METIS_PartGraphKway) (&vertnbr, &nconval, verttab, edgetab, velotab, NULL, edlotab,
+                                              &partnbr, awgttab, kbaltab, options, &edgecut, parttab) != METIS_OK) {
+    SCOTCH_errorPrint ("main: error in METIS_V5_PartGraphKway (4)");
+    exit (EXIT_FAILURE);
+  }
+
+  checkPart (baseval, vertnbr, parttab, partnbr);
+
+  if (SCOTCHMETISNAMEC (METIS_NodeND) (&vertnbr, verttab, edgetab, velotab, options, peritab, parttab) != METIS_OK) {
+    SCOTCH_errorPrint ("main: error in METIS_V5_NodeND (2)");
+    exit (EXIT_FAILURE);
+  }
+
+  checkOrder (baseval, vertnbr, parttab, peritab);
 #endif /* (SCOTCH_METIS_VERSION == 5) */
 
   free (peritab);

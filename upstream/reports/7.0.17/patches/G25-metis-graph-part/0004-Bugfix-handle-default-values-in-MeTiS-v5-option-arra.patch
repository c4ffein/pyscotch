 #include "common.h"
 #include "scotch.h"
 #include "metis.h"                                /* Our "metis.h" file */
+#include "metis_options.h"
+
+/***********************************/
+/*                                 */
+/* This routine is the internal    */
+/* MeTiS option reading routine.   */
+/*                                 */
+/***********************************/
+
+/* This routine returns the value of the given
+** option, or the given default value if no
+** option array is provided or if the option
+** value is -1, which means "default" in MeTiS
+** v5. For the Fortran interface, null arrays
+** are those equal to the given reference array.
+** It returns:
+** - x  : the option value.
+*/
+
+SCOTCH_Num
+_SCOTCH_METIS_optionGet (
+const SCOTCH_Num * const    options,              /*+ Option array, or NULL                         +*/
+const SCOTCH_Num * const    nulltab,              /*+ Array that stands for a null array in Fortran +*/
+const int                   optinum,              /*+ Index of option in array                      +*/
+const SCOTCH_Num            defaval)              /*+ Default value                                 +*/
+{
+  if ((options == NULL) ||                        /* If no option array or default value requested */
+      (options == nulltab) ||
+      (options[optinum] == -1))
+    return (defaval);
+
+  return (options[optinum]);
+}
 
 /*************************************/
 /*                                   */

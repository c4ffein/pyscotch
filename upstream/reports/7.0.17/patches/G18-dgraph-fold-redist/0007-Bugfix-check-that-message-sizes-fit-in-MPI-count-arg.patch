@@ -385,6 +385,10 @@ fail2:                                            /* No communication may still
     }
 
     for (commnum = 0, fldedgelocbas = orggrafptr->s.vertloctax[orggrafptr->s.vertlocnnd]; commnum < commnbr; commnum ++) {
+      if ((Gnum) (int) fldedgecnttab[commnum] != fldedgecnttab[commnum]) { /* Message sizes are passed to MPI as int's */

+  Gnum                      dsnddatnbr;
   int                       drcvdatidx;
   int                       dsnddatidx;
   Gnum                      srcvertlocnum;
@@ -234,8 +234,6 @@ Dgraph * restrict const     dstgrafptr)           /* Destination distributed gra
   Gnum                      dstedgedatsiz;        /* Size of destination edge data area                  */
   Gnum *                    dstedloloctax;        /* Pointer to destination edge load array [norestrict] */
   Gnum                      dstedlolocsiz;
-  int                       dstvertloctmp;        /* Vertex and edge numbers, as (int)s                  */
-  int                       dstedgeloctmp;
   Gnum                      procdspval;
   int                       procglbnbr;
   int                       cheklocval;
@@ -251,15 +249,23 @@ Dgraph * restrict const     dstgrafptr)           /* Destination distributed gra
 
   dstgrafptr->flagval |= (DGRAPHFREEALL ^ DGRAPHFREECOMM) | DGRAPHVERTGROUP | DGRAPHEDGEGROUP;
 
+  fledval = ((srcgrafptr->edloloctax != NULL) ? 1 : 0) + 1; /* Amount of data to exchange per edge  */
+  flveval = ((srcgrafptr->veloloctax != NULL) ? 1 : 0) + 3; /* Number, degree and label count for 3 */
+
   cheklocval = 0;
   procglbnbr = srcgrafptr->procglbnbr;
-  if (memAllocGroup ((void **) (void *)           /* Allocate distributed graph private data */
-                     &dstgrafptr->procdsptab, (size_t) ((procglbnbr + 1) * sizeof (Gnum)),
-                     &dstgrafptr->procvrttab, (size_t) ((procglbnbr + 1) * sizeof (Gnum)),
-                     &dstgrafptr->proccnttab, (size_t) (procglbnbr       * sizeof (Gnum)),
-                     &dstgrafptr->procngbtab, (size_t) (procglbnbr       * sizeof (int)),
-                     &dstgrafptr->procrcvtab, (size_t) (procglbnbr       * sizeof (int)),
-                     &dstgrafptr->procsndtab, (size_t) (procglbnbr       * sizeof (int)), NULL) == NULL) {
+  dsnddatnbr = srcgrafptr->vertlocnbr * flveval + srcgrafptr->edgelocnbr * fledval; /* Upper bound on amount of data to send */
+  if ((Gnum) (int) dsnddatnbr != dsnddatnbr) {    /* Data counts are passed to MPI as int's */
+    errorPrint ("dgraphRedist2: communication size out of range (1)");
+    cheklocval = 1;
+  }
+  else if (memAllocGroup ((void **) (void *)      /* Allocate distributed graph private data */
+                          &dstgrafptr->procdsptab, (size_t) ((procglbnbr + 1) * sizeof (Gnum)),
+                          &dstgrafptr->procvrttab, (size_t) ((procglbnbr + 1) * sizeof (Gnum)),
+                          &dstgrafptr->proccnttab, (size_t) (procglbnbr       * sizeof (Gnum)),
+                          &dstgrafptr->procngbtab, (size_t) (procglbnbr       * sizeof (int)),
+                          &dstgrafptr->procrcvtab, (size_t) (procglbnbr       * sizeof (int)),
+                          &dstgrafptr->procsndtab, (size_t) (procglbnbr       * sizeof (int)), NULL) == NULL) {
     errorPrint ("dgraphRedist2: out of memory (1)");
     cheklocval = 1;
   }
@@ -295,29 +301,32 @@ Dgraph * restrict const     dstgrafptr)           /* Destination distributed gra
     return (1);
   }
 
-  fledval = ((srcgrafptr->edloloctax != NULL) ? 1 : 0) + 1; /* Amount of data to exchange per edge  */
-  flveval = ((srcgrafptr->veloloctax != NULL) ? 1 : 0) + 3; /* Number, degree and label count for 3 */
-
-  for (procnum = 0, drcvdatidx = dsnddatidx = 0, dstvertloctmp = dstedgeloctmp = 0;
+  for (procnum = 0, drcvdatnbr = dsnddatnbr = 0, dstvertlocnbr = dstedgelocnbr = 0;
        procnum < procglbnbr; procnum ++) {        /* Compute start indices for data send and receive arrays */
     int                 dsndcntval;
     int                 drcvcntval;
 
-    dsndcntval = dsndcnttab[2 * procnum] * flveval + dsndcnttab[2 * procnum + 1] * fledval;
+    dsndcntval = dsndcnttab[2 * procnum] * flveval + dsndcnttab[2 * procnum + 1] * fledval; /* Fit in int's as sender data do */
     drcvcntval = drcvcnttab[2 * procnum] * flveval + drcvcnttab[2 * procnum + 1] * fledval;
-    dstvertloctmp += drcvcnttab[2 * procnum];     /* Accumulate number of vertices and edges */
-    dstedgeloctmp += drcvcnttab[2 * procnum + 1];
+    dstvertlocnbr += drcvcnttab[2 * procnum];     /* Accumulate number of vertices and edges */
+    dstedgelocnbr += drcvcnttab[2 * procnum + 1];
 
-    dsnddsptab[procnum] = dsnddatidx;
-    dsnddatidx += dsndcntval;
-    drcvdsptab[procnum] = drcvdatidx;
-    drcvdatidx += drcvcntval;
+    dsnddsptab[procnum] = (int) dsnddatnbr;       /* Accumulate amounts of data to allocate for sending and receiving */
+    dsnddatnbr += dsndcntval;
+    drcvdsptab[procnum] = (int) drcvdatnbr;
+    drcvdatnbr += drcvcntval;
   }
 
-  dsnddatnbr = dsnddatidx;                        /* Preserve amount of data to allocate for sending and receiving */
-  drcvdatnbr = drcvdatidx;
+  cheklocval = 1;                                 /* Assume an error  */
+  dstvertloctax =                                 /* In case of error */
+  dstedgeloctax = NULL;
+  if ((Gnum) (int) drcvdatnbr != drcvdatnbr) {    /* Data counts are passed to MPI as int's */
+    errorPrint ("dgraphRedist2: communication size out of range (2)");
+    goto fail;
+  }
 
-  for (procnum = procglbnbr - 1; procnum >= 0; procnum --) { /* Compute count arrays for data send and receive arrays */
+  for (procnum = procglbnbr - 1, dsnddatidx = (int) dsnddatnbr, drcvdatidx = (int) drcvdatnbr; /* Compute count arrays for data send and receive arrays */
+       procnum >= 0; procnum --) {
     int                 dsnddspval;
     int                 drcvdspval;
 
@@ -329,8 +338,6 @@ Dgraph * restrict const     dstgrafptr)           /* Destination distributed gra
     drcvdatidx = drcvdspval;
   }
 
-  dstvertlocnbr = (Gnum) dstvertloctmp;
-  dstedgelocnbr = (Gnum) dstedgeloctmp;
   dstedgelocsiz = dstedgelocnbr + dstedgelocdlt;
   dstvelolocsiz = (srcgrafptr->veloloctax != NULL) ? dstvertlocnbr + dstvertlocdlt : 0;
   dstedlolocsiz = (srcgrafptr->edloloctax != NULL) ? dstedgelocsiz : 0;
@@ -338,8 +345,6 @@ Dgraph * restrict const     dstgrafptr)           /* Destination distributed gra
                   ? (dstedlolocsiz + MAX (dstedgelocdlt, srcgrafptr->degrglbmax)) /* TRICK: extra space only for edge loads and degrmax, to avoid overlap */
                   : (dstedgelocsiz * fledval);    /* Else destination edge arrays must not overlap receive area */
 
-  cheklocval = 1;                                 /* Assume an error  */
-  dstedgeloctax = NULL;                           /* In case of error */
   if (memAllocGroup ((void **) (void *)
                      &dstvertloctax, (size_t) ((dstvertlocnbr + dstvertlocdlt + 1) * sizeof (Gnum)), /* Create compact array */
                      &dstveloloctax, (size_t) ( dstvelolocsiz                      * sizeof (Gnum)),

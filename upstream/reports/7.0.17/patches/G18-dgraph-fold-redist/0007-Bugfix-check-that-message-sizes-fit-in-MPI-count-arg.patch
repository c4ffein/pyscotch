From f493264084b057ee7dfc048c7cc0ac195fd8cf55 Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 12:52:00 +0000
Subject: [PATCH 7/7] Bugfix: check that message sizes fit in MPI count
 arguments in folding and redistribution [report R. Perry]

Vertex and edge message sizes of `dgraphFold2()` and `hdgraphFold2()`,
and data counts of `dgraphRedist2()`, are `Gnum`s that are passed to
MPI as `int` counts and displacements. With 64-bit `Gnum`s, sizes above
`INT_MAX` were silently truncated, and `dgraphRedist2()` accumulated
its data totals in `int`s.

Check in `dgraphFoldComm()` that the maximum number of local vertices,
which bounds all vertex message sizes, fits in an `int`, and check
received edge counts on receivers before edge arrays are allocated,
so that the folding fails collectively in both cases. In
`dgraphRedist2()`, accumulate data totals as `Gnum`s and check, before
the existing agreements, that the amounts of data to send and to
receive fit in `int`s.

Refs: DGR-22
---
 src/libscotch/dgraph_fold.c      |  4 ++
 src/libscotch/dgraph_fold_comm.c |  5 +++
 src/libscotch/dgraph_redist.c    | 63 +++++++++++++++++---------------
 src/libscotch/hdgraph_fold.c     |  4 ++
 4 files changed, 47 insertions(+), 29 deletions(-)

diff --git a/src/libscotch/dgraph_fold.c b/src/libscotch/dgraph_fold.c
index f55aae5..e5e1b20 100644
--- a/src/libscotch/dgraph_fold.c
+++ b/src/libscotch/dgraph_fold.c
@@ -388,6 +388,10 @@ fail2:                                            /* No communication may still
     }
 
     for (commnum = 0, fldedgelocbas = orgvertloctax[orggrafptr->vertlocnnd]; commnum < commnbr; commnum ++) {
+      if ((Gnum) (int) fldedgecnttab[commnum] != fldedgecnttab[commnum]) { /* Message sizes are passed to MPI as int's */
+        errorPrint ("dgraphFold2: communication size out of range");
+        goto fail3;
+      }
       fldedgeidxtab[commnum] = fldedgelocbas;
       fldedgelocbas += fldedgecnttab[commnum];    /* Accumulate received edges in addition to local edges */
     }
diff --git a/src/libscotch/dgraph_fold_comm.c b/src/libscotch/dgraph_fold_comm.c
index 3dc4d67..921f13d 100644
--- a/src/libscotch/dgraph_fold_comm.c
+++ b/src/libscotch/dgraph_fold_comm.c
@@ -163,6 +163,11 @@ Gnum * restrict * restrict const                vertdlttabptr) /* Pointer to glo
   }
 #endif /* SCOTCH_DEBUG_DGRAPH2 */
 
+  if ((Gnum) (int) grafptr->vertglbmax != grafptr->vertglbmax) { /* Vertex message sizes are passed to MPI as int's */
+    errorPrint ("dgraphFoldComm: communication size out of range");
+    return (1);
+  }
+
   if ((procsrttab = memAlloc (orgprocglbnbr * sizeof (DgraphFoldCommData))) == NULL) {
     errorPrint ("dgraphFoldComm: out of memory (1)");
     return (1);
diff --git a/src/libscotch/dgraph_redist.c b/src/libscotch/dgraph_redist.c
index cd5c730..c2098ba 100644
--- a/src/libscotch/dgraph_redist.c
+++ b/src/libscotch/dgraph_redist.c

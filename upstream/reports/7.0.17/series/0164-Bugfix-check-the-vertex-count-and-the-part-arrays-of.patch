From 8927f7bf313f7f1c787881d8fc0f573c54f1d1dd Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 16:15:36 +0000
Subject: [PATCH 164/240] Bugfix: check the vertex count and the part arrays of
 the mapping saved by `dmapSave()` [report R. Perry and PyScotch]

The test on the global number of mapped vertices could never fire, as
it required this number to be both negative and greater than the
number of processes. Require the mapping to be either empty or
complete, as `dmapTerm()` does.

Moreover, a fragment without a part array, as left by a sequential
mapping strategy that does not compute one, was dereferenced on the
root process and on the others. Count such fragments in the initial
reduction, so that all processes give up at once: a non-root process
that gave up later would leave the root process waiting for its
fragments.

Refs: DMO-15
---
 src/libscotch/dmapping_io.c | 26 +++++++++++++++++---------
 1 file changed, 17 insertions(+), 9 deletions(-)

diff --git a/src/libscotch/dmapping_io.c b/src/libscotch/dmapping_io.c
index 717381e..2250269 100644
--- a/src/libscotch/dmapping_io.c
+++ b/src/libscotch/dmapping_io.c
@@ -1,4 +1,4 @@
-/* Copyright 2008,2010,2014,2021,2023,2025 IPB, Universite de Bordeaux, INRIA & CNRS
+/* Copyright 2008,2010,2014,2021,2023,2025,2026 IPB, Universite de Bordeaux, INRIA & CNRS
 **
 ** This file is part of the Scotch software package for static mapping,
 ** graph partitioning and sparse matrix ordering.
@@ -45,7 +45,7 @@
 /**                # Version 6.1  : from : 05 apr 2021     **/
 /**                                 to   : 05 apr 2021     **/
 /**                # Version 7.0  : from : 18 jan 2023     **/
-/**                                 to   : 09 oct 2025     **/
+/**                                 to   : 13 oct 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -67,7 +67,7 @@
 /*                                  */
 /************************************/
 
-DGRAPHALLREDUCEMAXSUMOP (1, 5)
+DGRAPHALLREDUCEMAXSUMOP (1, 6)
 
 /* This routine saves a distributed mapping.
 ** The distributed graph structure is provided
@@ -91,8 +91,8 @@ FILE * restrict const           stream)
   Gnum                          vertrcvmax;
   Gnum                          vertglbnbr;
   Gnum * restrict               vlbltax;
-  Gnum                          reduloctab[6];
-  Gnum                          reduglbtab[6];
+  Gnum                          reduloctab[7];
+  Gnum                          reduglbtab[7];
   int                           protnum;
 
   reduloctab[0] = dmapptr->vertlocmax;
@@ -107,8 +107,12 @@ FILE * restrict const           stream)
     reduloctab[4] = 0;
   }
   reduloctab[5] = (grafptr->vlblloctax != NULL) ? 1 : 0; /* See if vertex labels provided */
+  for (fragptr = dmapptr->fragptr, reduloctab[6] = 0; fragptr != NULL; fragptr = fragptr->nextptr) { /* Count fragments without part array */
+    if (fragptr->parttab == NULL)
+      reduloctab[6] ++;
+  }
 
-  if (dgraphAllreduceMaxSum (reduloctab, reduglbtab, 1, 5, grafptr->proccomm) != 0) {
+  if (dgraphAllreduceMaxSum (reduloctab, reduglbtab, 1, 6, grafptr->proccomm) != 0) {
     errorPrint ("dmapSave: communication error (1)");
     return (1);
   }
@@ -120,10 +124,14 @@ FILE * restrict const           stream)
     errorPrint ("dmapSave: inconsistent parameters");
     return (1);
   }
-  if ((reduglbtab[1] < 0) && (reduglbtab[1] > grafptr->procglbnbr)) {
+  if ((reduglbtab[1] != 0) && (reduglbtab[1] != grafptr->vertglbnbr)) { /* Mapping must be either empty or complete */
     errorPrint ("dmapSave: invalid mapping (1)");
     return (1);
   }
+  if (reduglbtab[6] != 0) {                       /* All processes must give up before the root waits for fragments */
+    errorPrint ("dmapSave: invalid mapping (2)");
+    return (1);
+  }
   vertrcvmax = reduglbtab[0];                     /* Size of largest fragment to receive */
   vertglbnbr = reduglbtab[1];
   fragglbnbr = reduglbtab[2];
@@ -189,7 +197,7 @@ FILE * restrict const           stream)
         vnumnum = fragptr->vnumtab[fraglocnum];
 #ifdef SCOTCH_DEBUG_DMAP2
         if ((vnumnum < 0) || (vnumnum >= (grafptr->vertglbnbr + grafptr->baseval))) {
-          errorPrint ("dmapSave: invalid mapping (2)");
+          errorPrint ("dmapSave: invalid mapping (3)");
           return (1);
         }
 #endif /* SCOTCH_DEBUG_DMAP2 */
@@ -249,7 +257,7 @@ FILE * restrict const           stream)
 
         vnumnum = fragptr->vnumtab[fraglocnum];
         if ((vnumnum < 0) || (vnumnum >= (grafptr->vertglbnbr + grafptr->baseval))) {
-          errorPrint ("dmapSave: invalid mapping (3)");
+          errorPrint ("dmapSave: invalid mapping (4)");
           return (1);
         }
 #endif /* SCOTCH_DEBUG_DMAP2 */

 /**                                 to   : 21 nov 2021     **/
 /**                # Version 7.0  : from : 05 may 2019     **/
-/**                                 to   : 03 oct 2025     **/
+/**                                 to   : 13 oct 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -65,6 +65,7 @@
 
 #include "module.h"
 #include "common.h"
+#include "context.h"
 #include "parser.h"
 #include "graph.h"
 #include "order.h"
@@ -285,6 +286,9 @@ const HgraphOrderNdParam * restrict const paraptr)
   }
   if (o == 0) {
     HgraphOrderNdSplit  spltdat;                  /* Parameters for context splitting */
+#ifndef HGRAPHORDERNDNOTHREAD
+    INT                 deteval;                  /* Flag set if deterministic behavior wanted */
+#endif /* HGRAPHORDERNDNOTHREAD */
 
     spltdat.splttab[0].vnumnbr = vsplisttab[0].vnumnbr;
     spltdat.splttab[0].vnumtab = vsplisttab[0].vnumtab;
@@ -302,7 +306,9 @@ const HgraphOrderNdParam * restrict const paraptr)
     spltdat.revaptr = &o;
 
 #ifndef HGRAPHORDERNDNOTHREAD
-    if (contextThreadLaunchSplit (grafptr->contptr, (ContextSplitFunc) hgraphOrderNd2, &spltdat) != 0) /* If counld not split context to run concurrently */
+    contextValuesGetInt (grafptr->contptr, CONTEXTOPTIONNUMDETERMINISTIC, &deteval);
+    if ((deteval != 0) ||                         /* If deterministic behavior wanted, or if could not split context to run concurrently */
+        (contextThreadLaunchSplit (grafptr->contptr, (ContextSplitFunc) hgraphOrderNd2, &spltdat) != 0))
 #endif /* HGRAPHORDERNDNOTHREAD */
     {
       hgraphOrderNd2 (grafptr->contptr, 0, &spltdat); /* Run tasks in sequence */

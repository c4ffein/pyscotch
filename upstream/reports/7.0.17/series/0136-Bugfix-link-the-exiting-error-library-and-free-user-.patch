From 0887ea6cd4b889001b4741eac9a9c4760d29fdcd Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 14:06:39 +0000
Subject: [PATCH 136/240] Bugfix: link the exiting error library and free user
 arrays in `adm2dgr` [report R. Perry]

In the CMake build, `adm2dgr` linked `ptscotcherr`, whose `errorPrint()`
returns, while the code (like every other tool) assumes it exits: after a
failed call it went on to dereference uninitialised arrays. The Makefile
already links an exiting error library. Link `ptscotcherrexit` in CMake too.

Also tidy the tool: free `prelvrttab` with `memFree()` (it was allocated
with `memAlloc()`), free the `malloc()`ed dual graph arrays returned by
`SCOTCH_ParMETIS_V3_Mesh2Dual()`, correct the misleading error message
naming `dmeshBuildAdm`, and initialise the distributed graph on the
program communicator instead of `MPI_COMM_WORLD`.

Refs: CLI-04
---
 src/libscotchmetis/CMakeLists.txt |  2 +-
 src/libscotchmetis/adm2dgr.c      | 12 +++++++-----
 2 files changed, 8 insertions(+), 6 deletions(-)

diff --git a/src/libscotchmetis/CMakeLists.txt b/src/libscotchmetis/CMakeLists.txt
index 107a05d..49407e7 100644
--- a/src/libscotchmetis/CMakeLists.txt
+++ b/src/libscotchmetis/CMakeLists.txt
@@ -225,7 +225,7 @@ if(BUILD_PTSCOTCH)
     # adm2dgr
     add_executable(adm2dgr adm2dgr.c adm2dgr.h)
     add_dependencies(adm2dgr parmetis_h)
-    target_link_libraries(adm2dgr PRIVATE ptscotchparmetisv${version} ptscotch scotch ptscotcherr)
+    target_link_libraries(adm2dgr PRIVATE ptscotchparmetisv${version} ptscotch scotch ptscotcherrexit)
     install(TARGETS adm2dgr COMPONENT ptscotch RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
   endforeach(version 3)
 endif()
diff --git a/src/libscotchmetis/adm2dgr.c b/src/libscotchmetis/adm2dgr.c
index 4ce13d5..7b3af88 100644
--- a/src/libscotchmetis/adm2dgr.c
+++ b/src/libscotchmetis/adm2dgr.c
@@ -1,4 +1,4 @@
-/* Copyright 2024-2025 IPB, Universite de Bordeaux, INRIA & CNRS
+/* Copyright 2024-2026 IPB, Universite de Bordeaux, INRIA & CNRS
 **
 ** This file is part of the Scotch software package for static mapping,
 ** graph partitioning and sparse matrix ordering.
@@ -42,7 +42,7 @@
 /**                graph of the mesh.                      **/
 /**                                                        **/
 /**   DATES      : # Version 7.0  : from : 11 jan 2024     **/
-/**                                 to   : 08 oct 2025     **/
+/**                                 to   : 13 oct 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -185,7 +185,7 @@ char *                      argv[])
     errorPrint ("main: out of memory");
   if (MPI_Allgather (&velmlocnbr, 1, SCOTCH_NUM_MPI,
                      prelvrttab,  1, SCOTCH_NUM_MPI, proccomm) != MPI_SUCCESS) {
-    errorPrint ("dmeshBuildAdm: communication error");
+    errorPrint ("main: communication error");
     return (1);
   }
   preldspadj = baseval;                           /* Use the new base to build displacement array */
@@ -205,7 +205,7 @@ char *                      argv[])
   vertlocnbr = velmlocnbr;
   edgelocnbr = vertloctab[vertlocnbr] - baseval;
 
-  SCOTCH_dgraphInit (&grafdat, MPI_COMM_WORLD);
+  SCOTCH_dgraphInit (&grafdat, proccomm);
 
   if (SCOTCH_dgraphBuild (&grafdat, baseval,
                           vertlocnbr, vertlocnbr, vertloctab, vertloctab + 1, NULL, NULL,
@@ -217,7 +217,9 @@ char *                      argv[])
   SCOTCH_dgraphExit  (&grafdat);
   SCOTCH_dmeshExit   (&meshdat);
 
-  free (prelvrttab);
+  free    (vertloctab);                           /* Dual graph arrays are plain malloc()'ed by SCOTCH_ParMETIS_V3_Mesh2Dual() */
+  free    (edgeloctab);
+  memFree (prelvrttab);                           /* Element distribution array was allocated with memAlloc() */
 
   fileBlockClose (C_fileTab, C_FILENBR);
 

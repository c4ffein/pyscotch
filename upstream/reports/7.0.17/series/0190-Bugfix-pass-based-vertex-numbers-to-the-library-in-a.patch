From 6f76604cf280dc284db653e60d2764d090fd136b Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 16:06:23 +0000
Subject: [PATCH 190/240] Bugfix: pass based vertex numbers to the library in
 `amk_grf` [report R. Perry]

When the source graph has vertex labels, the vertex list is turned
into vertex numbers before being passed to `SCOTCH_archBuild0()` or
`SCOTCH_archBuild2()`, which expect based vertex numbers. Un-based
numbers were passed, which selected the wrong vertices for graphs of
base 1, and read before the vertex arrays for the first vertex.
When the source graph has no vertex labels, list values are now
checked against the vertex range of the graph.

Refs: CLI-11
---
 src/check/CMakeLists.txt |  2 ++
 src/check/Makefile       |  1 +
 src/scotch/amk_grf.c     | 15 ++++++++++-----
 3 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/src/check/CMakeLists.txt b/src/check/CMakeLists.txt
index 7a3e91f..eb41427 100644
--- a/src/check/CMakeLists.txt
+++ b/src/check/CMakeLists.txt
@@ -538,6 +538,8 @@ add_test(NAME amk_grf_m4x4 COMMAND $<TARGET_FILE:amk_grf> -l${dat}/m4x4_vertlist
 
 add_test(NAME amk_grf_m4x4_2 COMMAND $<TARGET_FILE:amk_grf> -l${dat}/m4x4_vertlist.txt -2 ${dat}/m4x4.grf ${dev_null})
 
+add_test(NAME amk_grf_m4x4_b1_elv COMMAND $<TARGET_FILE:amk_grf> -l${dat}/m4x4_vertlist.txt ${dat}/m4x4_b1_elv.grf ${dev_null})
+
 # check_prog_atst
 
 add_test(NAME atst_4x4x4 COMMAND $<TARGET_FILE:atst> ${tgt}/t4x4x4.tgt)
diff --git a/src/check/Makefile b/src/check/Makefile
index d71fc5c..7daabb7 100644
--- a/src/check/Makefile
+++ b/src/check/Makefile
@@ -713,6 +713,7 @@ check_prog_amk_grf		:	check_prog_atst
 					$(EXECS) $(SCOTCHBINDIR)/amk_grf -2 data/m16x16.grf | $(SCOTCHBINDIR)/atst
 					$(EXECS) $(SCOTCHBINDIR)/amk_grf -ldata/m4x4_vertlist.txt data/m4x4.grf | $(SCOTCHBINDIR)/atst
 					$(EXECS) $(SCOTCHBINDIR)/amk_grf -ldata/m4x4_vertlist.txt -2 data/m4x4.grf | $(SCOTCHBINDIR)/atst
+					$(EXECS) $(SCOTCHBINDIR)/amk_grf -ldata/m4x4_vertlist.txt data/m4x4_b1_elv.grf | $(SCOTCHBINDIR)/atst
 
 check_prog_atst			:
 					$(EXECS) $(SCOTCHBINDIR)/atst $(SCOTCHTGTDIR)/t4x4x4.tgt
diff --git a/src/scotch/amk_grf.c b/src/scotch/amk_grf.c
index d64d3bb..5267373 100644
--- a/src/scotch/amk_grf.c
+++ b/src/scotch/amk_grf.c
@@ -1,4 +1,4 @@
-/* Copyright 2004,2007,2008,2010-2012,2014,2018,2019,2023 IPB, Universite de Bordeaux, INRIA & CNRS
+/* Copyright 2004,2007,2008,2010-2012,2014,2018,2019,2023,2026 IPB, Universite de Bordeaux, INRIA & CNRS
 **
 ** This file is part of the Scotch software package for static mapping,
 ** graph partitioning and sparse matrix ordering.
@@ -57,7 +57,7 @@
 /**                # Version 6.0  : from : 01 jan 2012     **/
 /**                                 to   : 24 sep 2019     **/
 /**                # Version 7.0  : from : 21 jan 2023     **/
-/**                                 to   : 21 jan 2023     **/
+/**                                 to   : 13 oct 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -196,7 +196,12 @@ char *                      argv[])
         errorPrint ("main: duplicate list labels");
     }
 
-    if (vlbltab != NULL) {                        /* If graph has vertex labels */
+    if (vlbltab == NULL) {                        /* If graph has no vertex labels, list holds based vertex numbers */
+      if ((listnbr > 0) &&                        /* List is sorted: check its bounds                               */
+          ((listtab[0] < baseval) || (listtab[listnbr - 1] >= (vertnbr + baseval))))
+        errorPrint ("main: list vertex number out of range");
+    }
+    else {                                        /* If graph has vertex labels */
       SCOTCH_Num          vertnum;
 
       if ((sorttab = (C_VertSort *) memAlloc (vertnbr * sizeof (C_VertSort))) == NULL)
@@ -204,7 +209,7 @@ char *                      argv[])
 
       for (vertnum = 0; vertnum < vertnbr; vertnum ++) { /* Initialize sort area */
         sorttab[vertnum].vlblnum = vlbltab[vertnum];
-        sorttab[vertnum].vertnum = vertnum;
+        sorttab[vertnum].vertnum = vertnum + baseval; /* Library expects based vertex numbers */
       }
       intSort2asc1 (sorttab, vertnbr);            /* Sort by ascending labels */
 
@@ -215,7 +220,7 @@ char *                      argv[])
             (sorttab[vertnum].vlblnum > listtab[listnum]))
           errorPrint ("main: list label '" SCOTCH_NUMSTRING "' not in graph", (SCOTCH_Num) listtab[listnum]);
 
-        listtab[listnum] = sorttab[vertnum ++].vertnum; /* Replace label by number */
+        listtab[listnum] = sorttab[vertnum ++].vertnum; /* Replace label by based vertex number */
       }
       memFree (sorttab);                          /* Free sort area */
     }

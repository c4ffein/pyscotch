From ab0f1aa1a67170ba2dadd7b44f13fdd76fce75d9 Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 14:03:44 +0000
Subject: [PATCH 130/240] Bugfix: check the parameters of `dgraphBuildGrid3D()`
 in all build modes [report PyScotch]

The checks on the grid dimensions and on the increment value were only
compiled in debug mode, although these values come straight from the
`SCOTCH_dgraphBuildGrid3D()` API routine. A zero increment or a zero
dimension led to an integer division by zero, and a negative increment
to an invalid graph being returned as valid.

Always perform the checks, and account for them in the agreement
between processes so that all processes return consistently.

Refs: PS2-G17-1
---
 src/libscotch/dgraph_build_grid3d.c | 26 ++++++++++----------------
 1 file changed, 10 insertions(+), 16 deletions(-)

diff --git a/src/libscotch/dgraph_build_grid3d.c b/src/libscotch/dgraph_build_grid3d.c
index a6bf09a..71e0178 100644
--- a/src/libscotch/dgraph_build_grid3d.c
+++ b/src/libscotch/dgraph_build_grid3d.c
@@ -1,4 +1,4 @@
-/* Copyright 2007,2010,2023,2024 IPB, Universite de Bordeaux, INRIA & CNRS
+/* Copyright 2007,2010,2023,2024,2026 IPB, Universite de Bordeaux, INRIA & CNRS
 **
 ** This file is part of the Scotch software package for static mapping,
 ** graph partitioning and sparse matrix ordering.
@@ -306,17 +306,6 @@ const Gnum                  flagval)              /* Grid type        */
   Gnum                  reduloctab[13];
   Gnum                  reduglbtab[13];
 
-#ifdef SCOTCH_DEBUG_DGRAPH1
-  if ((dimxval < 1) || (dimyval < 1) || (dimzval < 1)) { /* At least one vertex */
-    errorPrint ("dgraphBuildGrid3D: invalid parameters (1)");
-    return     (1);
-  }
-  if (incrval < 1) {
-    errorPrint ("dgraphBuildGrid3D: invalid parameters (2)");
-    return     (1);
-  }
-#endif /* SCOTCH_DEBUG_DGRAPH1 */
-
   vertglbnbr = dimxval * dimyval * dimzval;
   vertlocnbr = DATASIZE (vertglbnbr, grafptr->procglbnbr, grafptr->proclocnum);
 
@@ -347,10 +336,15 @@ const Gnum                  flagval)              /* Grid type        */
   cheklocval = 0;
   vertloctax =
   edgeloctab = NULL;
-  if (memAllocGroup ((void **) (void *)
-                     &vertloctax, (size_t) ((vertlocnbr + 1) * sizeof (Gnum)), /* +1 to indicate end of array */
-                     &veloloctax, (size_t) (velolocsiz       * sizeof (Gnum)),
-                     &vlblloctax, (size_t) (vlbllocsiz       * sizeof (Gnum)), NULL) == NULL) {
+  if ((dimxval < 1) || (dimyval < 1) || (dimzval < 1) || /* At least one vertex, and a positive increment */
+      (incrval < 1)) {
+    errorPrint ("dgraphBuildGrid3D: invalid parameters");
+    cheklocval = 1;
+  }
+  else if (memAllocGroup ((void **) (void *)
+                          &vertloctax, (size_t) ((vertlocnbr + 1) * sizeof (Gnum)), /* +1 to indicate end of array */
+                          &veloloctax, (size_t) (velolocsiz       * sizeof (Gnum)),
+                          &vlblloctax, (size_t) (vlbllocsiz       * sizeof (Gnum)), NULL) == NULL) {
     errorPrint ("dgraphBuildGrid3D: out of memory (1)");
     cheklocval = 1;
   }

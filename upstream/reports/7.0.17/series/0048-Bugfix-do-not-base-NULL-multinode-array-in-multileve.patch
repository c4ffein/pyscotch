From 79995bcbfd7799a02bce287a70ce43156a3f8214 Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 12:56:46 +0000
Subject: [PATCH 048/240] Bugfix: do not base NULL multinode array in
 multilevel uncoarsening routines [report R. Perry]

`bgraphBipartMlUncoarsen()` and `kgraphMapMlUncoarsen()` are called with
a NULL multinode array when no coarse graph is provided; computing the
based access pointer from it is undefined behavior for non-zero base
values, which the undefined behavior sanitizer reports for every based
graph. Compute it only when the array exists, as elsewhere.

Refs: GRA-26
---
 src/libscotch/bgraph_bipart_ml.c | 6 +++---
 src/libscotch/kgraph_map_ml.c    | 6 +++---
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/src/libscotch/bgraph_bipart_ml.c b/src/libscotch/bgraph_bipart_ml.c
index a077e52..7ce56a6 100644
--- a/src/libscotch/bgraph_bipart_ml.c
+++ b/src/libscotch/bgraph_bipart_ml.c
@@ -1,4 +1,4 @@
-/* Copyright 2004,2007-2011,2014,2015,2018,2023 IPB, Universite de Bordeaux, INRIA & CNRS
+/* Copyright 2004,2007-2011,2014,2015,2018,2023,2026 IPB, Universite de Bordeaux, INRIA & CNRS
 **
 ** This file is part of the Scotch software package for static mapping,
 ** graph partitioning and sparse matrix ordering.
@@ -55,7 +55,7 @@
 /**                # Version 6.0  : from : 09 mar 2011     **/
 /**                                 to   : 16 aug 2015     **/
 /**                # Version 7.0  : from : 08 jun 2018     **/
-/**                                 to   : 17 jan 2023     **/
+/**                                 to   : 13 oct 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -192,7 +192,7 @@ const GraphCoarsenMulti * const coarmulttab)      /*+ Pointer to un-based multin
   Gnum                        finefronnbr;
   Gnum                        finecompsize1;
 
-  const GraphCoarsenMulti * const coarmulttax = coarmulttab - finegrafptr->s.baseval;
+  const GraphCoarsenMulti * const coarmulttax = (coarmulttab != NULL) ? (coarmulttab - finegrafptr->s.baseval) : NULL;
   const Gnum * restrict const     fineverttax = finegrafptr->s.verttax; /* Fast accesses */
   const Gnum * restrict const     finevendtax = finegrafptr->s.vendtax;
   const Gnum * restrict const     fineedgetax = finegrafptr->s.edgetax;
diff --git a/src/libscotch/kgraph_map_ml.c b/src/libscotch/kgraph_map_ml.c
index 4de54a0..1299bf8 100644
--- a/src/libscotch/kgraph_map_ml.c
+++ b/src/libscotch/kgraph_map_ml.c
@@ -1,4 +1,4 @@
-/* Copyright 2010,2011,2012,2014,2015,2018,2021,2023,2024 IPB, Universite de Bordeaux, INRIA & CNRS
+/* Copyright 2010,2011,2012,2014,2015,2018,2021,2023,2024,2026 IPB, Universite de Bordeaux, INRIA & CNRS
 **
 ** This file is part of the Scotch software package for static mapping,
 ** graph partitioning and sparse matrix ordering.
@@ -45,7 +45,7 @@
 /**                # Version 6.0  : from : 03 mar 2011     **/
 /**                                 to   : 25 feb 2018     **/
 /**                # Version 7.0  : from : 03 aug 2018     **/
-/**                                 to   : 19 jul 2024     **/
+/**                                 to   : 13 oct 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -236,7 +236,7 @@ const GraphCoarsenMulti * const coarmulttab)      /*+ Pointer to multinode array
   Gnum                  finefronnum;
   Anum * restrict       fineparttax;              /* May not have been allocated yet             */
 
-  const GraphCoarsenMulti * restrict const coarmulttax = coarmulttab - finegrafptr->s.baseval;
+  const GraphCoarsenMulti * restrict const coarmulttax = (coarmulttab != NULL) ? (coarmulttab - finegrafptr->s.baseval) : NULL;
   const Gnum * restrict const              fineverttax = finegrafptr->s.verttax;
   const Gnum * restrict const              finevendtax = finegrafptr->s.vendtax;
   const Gnum * restrict const              fineedgetax = finegrafptr->s.edgetax;

+        (SCOTCH_stratGraphOrderBuild   (&stradat, SCOTCH_STRATDEFAULT, 0, balval)         == 0) ||
+        (SCOTCH_stratMeshOrderBuild    (&stradat, SCOTCH_STRATDEFAULT, balval)            == 0)) {
+      SCOTCH_errorPrint ("main: invalid ratio accepted");
+      o |= 1;
+    }
+    SCOTCH_stratExit (&stradat);
+  }
+
   exit ((o == 0) ? EXIT_SUCCESS : EXIT_FAILURE);
 }

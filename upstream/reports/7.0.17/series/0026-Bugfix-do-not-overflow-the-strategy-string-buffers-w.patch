 src/check/test_strat_seq.c             | 21 +++++++++++++++++++++
 src/libscotch/library_dgraph_map.c     | 19 ++++++++++++++-----
 src/libscotch/library_dgraph_order.c   |  8 ++++++--
 src/libscotch/library_graph_map.c      | 19 ++++++++++++++-----
 src/libscotch/library_graph_order.c    |  8 ++++++--
 src/libscotch/library_graph_part_ovl.c |  8 ++++++--
 src/libscotch/library_mesh_order.c     |  8 ++++++--
 8 files changed, 94 insertions(+), 19 deletions(-)

diff --git a/src/check/test_strat_par.c b/src/check/test_strat_par.c
index 35dbdec..fcffe28 100644
--- a/src/check/test_strat_par.c
+++ b/src/check/test_strat_par.c
@@ -41,7 +41,7 @@
 /**   DATES      : # Version 6.0  : from : 08 jan 2012     **/
 /**                                 to   : 22 may 2018     **/
 /**                # Version 7.0  : from : 04 jul 2025     **/
-/**                                 to   : 26 mar 2026     **/
+/**                                 to   : 13 oct 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -73,6 +73,7 @@ int                 argc,
 char *              argv[])
 {
   SCOTCH_Strat        stradat;
+  int                 i;
   int                 o;
 
   SCOTCH_errorProg (argv[0]);
@@ -132,5 +133,24 @@ char *              argv[])
   o |= SCOTCH_stratDgraphOrderBuild (&stradat, SCOTCH_STRATSEPASIMPLE, 1, 0, 0.2);
   SCOTCH_stratExit (&stradat);
 
+  printf ("Parallel strategy builders, invalid ratios (error messages expected)\n");
+
+  for (i = 0; i < 3; i ++) {                      /* Non-finite, out-of-range and huge-but-finite ratios must all be rejected */
+    volatile double     zeroval;                  /* Volatile to build a NaN without a compile-time division */
+    double              balval;
+
+    zeroval = 0.0;
+    balval  = (i == 0) ? (zeroval / zeroval) : ((i == 1) ? -1.0 : 1e300); /* NaN, negative, huge finite */
+
+    SCOTCH_stratInit (&stradat);
+    if ((SCOTCH_stratDgraphMapBuild     (&stradat, SCOTCH_STRATDEFAULT, 3, 4, balval)         == 0) ||
+        (SCOTCH_stratDgraphClusterBuild (&stradat, SCOTCH_STRATDEFAULT, 3, 4, balval, balval) == 0) ||
+        (SCOTCH_stratDgraphOrderBuild   (&stradat, SCOTCH_STRATDEFAULT, 3, 0, balval)         == 0)) {
+      SCOTCH_errorPrint ("main: invalid ratio accepted");
+      o |= 1;
+    }
+    SCOTCH_stratExit (&stradat);
+  }
+
   exit ((o == 0) ? EXIT_SUCCESS : EXIT_FAILURE);
 }

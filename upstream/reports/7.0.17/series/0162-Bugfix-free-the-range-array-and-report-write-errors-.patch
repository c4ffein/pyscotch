From c5675d2bf19efdf61dbd462047f1ee3ebeafa4e6 Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 16:14:36 +0000
Subject: [PATCH 162/240] Bugfix: free the range array and report write errors
 in `dorderSaveBlock2()` [report R. Perry]

The column block range array was never freed, and the unconditional
writes that terminate the range and permutation lines overwrote the
status of the preceding loop, so that a write error was reported as
success.

Refs: DMO-13
---
 src/libscotch/dorder_io_block.c | 19 +++++++++++++------
 1 file changed, 13 insertions(+), 6 deletions(-)

diff --git a/src/libscotch/dorder_io_block.c b/src/libscotch/dorder_io_block.c
index efb6dd5..33237fb 100644
--- a/src/libscotch/dorder_io_block.c
+++ b/src/libscotch/dorder_io_block.c
@@ -1,4 +1,4 @@
-/* Copyright 2007,2008,2010,2023 IPB, Universite de Bordeaux, INRIA & CNRS
+/* Copyright 2007,2008,2010,2023,2026 IPB, Universite de Bordeaux, INRIA & CNRS
 **
 ** This file is part of the Scotch software package for static mapping,
 ** graph partitioning and sparse matrix ordering.
@@ -43,7 +43,7 @@
 /**                # Version 5.1  : from : 11 aug 2010     **/
 /**                                 to   : 11 aug 2010     **/
 /**                # Version 7.0  : from : 18 jan 2023     **/
-/**                                 to   : 18 jan 2023     **/
+/**                                 to   : 13 oct 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -95,6 +95,7 @@ FILE * const                  stream)
                (Gnum) cordptr->cblknbr,
                (Gnum) cordptr->vnodnbr) < 0) {
     errorPrint ("dorderSaveBlock2: bad output (1)");
+    memFree    (rangtab);
     return     (1);
   }
 
@@ -102,8 +103,10 @@ FILE * const                  stream)
     o = intSave (stream, rangtab[cblknum]);
     putc (((cblknum & 7) == 7) ? '\n' : '\t', stream);
   }
-  o = intSave (stream, rangtab[cblknum]);
-  putc ('\n', stream);
+  if (o == 1) {                                   /* If no write error so far */
+    o = intSave (stream, rangtab[cblknum]);
+    putc ('\n', stream);
+  }
 
   orderPeri (cordptr->peritab, cordptr->baseval, cordptr->vnodnbr, rangtab, cordptr->baseval); /* TRICK: re-use rangtab as permtab */
 
@@ -111,12 +114,16 @@ FILE * const                  stream)
     o = intSave (stream, rangtab[vertnum]);
     putc (((vertnum & 7) == 7) ? '\n' : '\t', stream);
   }
-  o = intSave (stream, rangtab[vertnum]);
-  putc ('\n', stream);
+  if (o == 1) {                                   /* If no write error so far */
+    o = intSave (stream, rangtab[vertnum]);
+    putc ('\n', stream);
+  }
 
   if (o != 1)
     errorPrint ("dorderSaveBlock2: bad output (2)");
 
+  memFree (rangtab);
+
   return (1 - o);
 }
 

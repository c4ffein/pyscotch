@@ -507,6 +507,7 @@
 #define archDeco2MatchInit          SCOTCH_NAME_INTERN (archDeco2MatchInit)
 #define archDistArchLoad            SCOTCH_NAME_INTERN (archDistArchLoad)
 #define archDistArchSave            SCOTCH_NAME_INTERN (archDistArchSave)

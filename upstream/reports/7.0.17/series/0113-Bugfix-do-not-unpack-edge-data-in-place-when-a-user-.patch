From 57a4c9c8266d09eb1773da0f165f9be62e5ae9b4 Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 09:23:54 +0000
Subject: [PATCH 113/240] Bugfix: do not unpack edge data in place when a user
 permutation is given to `dgraphRedist()` [report R. Perry]

In `dgraphRedist2()`, the destination edge array, the send buffer and
the receive buffer share a single memory block, and edge data are
unpacked in place, in destination vertex order. This can never overlap
only when vertices are received in destination order, which holds for
the permutation computed internally but not for a permutation provided
by the user through `SCOTCH_dgraphRedist()`: in this case, unpacking
could overwrite received data not yet read, and silently produce a wrong
graph.

Allocate a full-size destination edge data area when the permutation
is user-provided. Add a test case with a reversed user permutation to
`test_scotch_dgraph_redist.c`.

Refs: DGR-04
---
 src/check/test_scotch_dgraph_redist.c | 54 ++++++++++++++++++++++++---
 src/libscotch/dgraph_redist.c         | 16 +++++---
 src/libscotch/dgraph_redist.h         |  6 +--
 3 files changed, 62 insertions(+), 14 deletions(-)

diff --git a/src/check/test_scotch_dgraph_redist.c b/src/check/test_scotch_dgraph_redist.c
index ade4b9a..0c618b3 100644
--- a/src/check/test_scotch_dgraph_redist.c
+++ b/src/check/test_scotch_dgraph_redist.c
@@ -42,7 +42,7 @@
 /**   DATES      : # Version 6.0  : from : 21 feb 2012     **/
 /**                                 to   : 22 may 2018     **/
 /**                # Version 7.0  : from : 03 jul 2023     **/
-/**                                 to   : 11 oct 2026     **/
+/**                                 to   : 13 oct 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -72,10 +72,14 @@ char *              argv[])
   MPI_Comm            proccomm;
   int                 procglbnbr;                 /* Number of processes sharing graph data */
   int                 proclocnum;                 /* Number of this process                 */
+  SCOTCH_Num          baseval;
   SCOTCH_Num          vertglbnbr;
   SCOTCH_Num          vertlocnbr;
   SCOTCH_Num          vertlocnum;
+  SCOTCH_Num          vertglbnum;                 /* Global index of first local vertex */
+  SCOTCH_Num          vertgstnbr;
   SCOTCH_Num *        partloctab;
+  SCOTCH_Num *        permgsttab;
   SCOTCH_Dgraph       srcgrafdat;
   SCOTCH_Dgraph       dstgrafdat;
   FILE *              file;
@@ -160,10 +164,16 @@ char *              argv[])
     exit (EXIT_FAILURE);
   }
 
-  SCOTCH_dgraphData (&srcgrafdat, NULL, &vertglbnbr, &vertlocnbr, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
+  if (SCOTCH_dgraphGhst (&srcgrafdat) != 0) {     /* Permutation array must cover ghost vertices */
+    SCOTCH_errorPrint ("main: cannot compute ghost edge array");
+    exit (EXIT_FAILURE);
+  }
+
+  SCOTCH_dgraphData (&srcgrafdat, &baseval, &vertglbnbr, &vertlocnbr, NULL, &vertgstnbr, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
 
-  if ((partloctab = malloc (vertlocnbr * sizeof (SCOTCH_Num))) == NULL) {
-    SCOTCH_errorPrint ("main: cannot allocate part array");
+  if (((partloctab = malloc (vertlocnbr * sizeof (SCOTCH_Num))) == NULL) ||
+      ((permgsttab = malloc (vertgstnbr * sizeof (SCOTCH_Num))) == NULL)) {
+    SCOTCH_errorPrint ("main: cannot allocate part arrays");
     exit (EXIT_FAILURE);
   }
 
@@ -176,12 +186,46 @@ char *              argv[])
   }
 
   if (SCOTCH_dgraphCheck (&dstgrafdat) != 0) {
-    SCOTCH_errorPrint ("main: invalid redistributed graph");
+    SCOTCH_errorPrint ("main: invalid redistributed graph (1)");
+    exit (EXIT_FAILURE);
+  }
+
+  SCOTCH_dgraphExit (&dstgrafdat);
+
+  if (SCOTCH_dgraphInit (&dstgrafdat, proccomm) != 0) { /* Re-initialize destination graph */
+    SCOTCH_errorPrint ("main: cannot initialize destination graph (2)");
+    exit (EXIT_FAILURE);
+  }
+
+  if (MPI_Scan (&vertlocnbr, &vertglbnum, 1, SCOTCH_NUM_MPI, MPI_SUM, proccomm) != MPI_SUCCESS) {
+    SCOTCH_errorPrint ("main: cannot communicate (3)");
+    exit (EXIT_FAILURE);
+  }
+  vertglbnum -= vertlocnbr;                       /* Global index of first local vertex */
+
+  for (vertlocnum = 0; vertlocnum < vertlocnbr; vertlocnum ++) { /* Send all vertices to last process, with a permutation that reverses their order */
+    partloctab[vertlocnum] = procglbnbr - 1;
+    permgsttab[vertlocnum] = baseval + vertglbnbr - 1 - (vertglbnum + vertlocnum);
+  }
+
+  if (SCOTCH_dgraphHalo (&srcgrafdat, permgsttab, SCOTCH_NUM_MPI) != 0) { /* Propagate permutation to ghost vertices */
+    SCOTCH_errorPrint ("main: cannot propagate permutation");
+    exit (EXIT_FAILURE);
+  }
+
+  if (SCOTCH_dgraphRedist (&srcgrafdat, partloctab, permgsttab, 0, 0, &dstgrafdat) != 0) {
+    SCOTCH_errorPrint ("main: cannot compute permuted redistributed graph");
+    exit (EXIT_FAILURE);
+  }
+
+  if (SCOTCH_dgraphCheck (&dstgrafdat) != 0) {
+    SCOTCH_errorPrint ("main: invalid redistributed graph (2)");
     exit (EXIT_FAILURE);
   }
 
   SCOTCH_dgraphExit (&dstgrafdat);
   SCOTCH_dgraphExit (&srcgrafdat);
+  free (permgsttab);
   free (partloctab);
 
   MPI_Finalize ();
diff --git a/src/libscotch/dgraph_redist.c b/src/libscotch/dgraph_redist.c
index d8d74cd..1411ec0 100644
--- a/src/libscotch/dgraph_redist.c
+++ b/src/libscotch/dgraph_redist.c
@@ -41,7 +41,7 @@

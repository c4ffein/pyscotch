+/* This routine writes an ordering file in
+** which all vertices have their own index
+** as rank, save for vertex vertnum, which
+** has rank permval, and whose header holds
+** linenbr as number of ordering lines. It
+** then checks that loading it fails.
+** It exits on error.
+*/
+
+static
+void
+checkOrderLoad (
+const SCOTCH_Graph * const  grafptr,
+const SCOTCH_Num            baseval,
+const SCOTCH_Num            vertnbr,
+SCOTCH_Num * const          permtab,
+SCOTCH_Num * const          peritab,
+const SCOTCH_Num            linenbr,              /* Number of ordering lines in header */
+const SCOTCH_Num            vertnum,              /* Vertex whose rank is modified      */
+const SCOTCH_Num            permval)              /* Rank of this vertex                */
+{
+  SCOTCH_Ordering     ordedat;
+  FILE *              fileptr;
+  SCOTCH_Num          vertidx;
+
+  if ((fileptr = tmpfile ()) == NULL) {           /* Open temporary file for invalid ordering */
+    SCOTCH_errorPrint ("checkOrderLoad: cannot open file");
+    exit (EXIT_FAILURE);
+  }
+
+  fprintf (fileptr, "%ld\n", (long) linenbr);
+  for (vertidx = 0; vertidx < vertnbr; vertidx ++)
+    fprintf (fileptr, "%ld\t%ld\n", (long) (vertidx + baseval), (long) ((vertidx == vertnum) ? permval : (vertidx + baseval)));
+  rewind (fileptr);
+
+  if (SCOTCH_graphOrderInit (grafptr, &ordedat, permtab, peritab, NULL, NULL, NULL) != 0) {
+    SCOTCH_errorPrint ("checkOrderLoad: cannot initialize ordering");
+    exit (EXIT_FAILURE);
+  }
+
+  if (SCOTCH_graphOrderLoad (grafptr, &ordedat, fileptr) == 0) {
+    SCOTCH_errorPrint ("checkOrderLoad: invalid ordering file accepted");
+    exit (EXIT_FAILURE);
+  }
+
+  SCOTCH_graphOrderExit (grafptr, &ordedat);
+  fclose (fileptr);
+}
+
 /*********************/
 /*                   */
 /* The main routine. */

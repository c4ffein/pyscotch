     SCOTCH_errorPrint ("main: out of memory (2)");
     exit (EXIT_FAILURE);
   }
@@ -206,20 +258,62 @@ char *              argv[])
   if (o != 0)
     exit (EXIT_FAILURE);
 
+  if ((fileptr2 = tmpfile ()) == NULL) {          /* Open temporary file for ordering alone */
+    SCOTCH_errorPrint ("main: cannot open file (3)");
+    exit (EXIT_FAILURE);
+  }
+
+  if (SCOTCH_graphOrderSave (&grafdat, &ordedat, fileptr2) != 0) { /* Save ordering for reloading */
+    SCOTCH_errorPrint ("main: cannot save ordering");
+    exit (EXIT_FAILURE);
+  }
+  memcpy (peritmp, peritab, vertnbr * sizeof (SCOTCH_Num)); /* Keep computed inverse permutation */
+
   SCOTCH_graphOrderExit (&grafdat, &ordedat);     /* Free computed ordering */
 
-  if (SCOTCH_graphOrderInit (&grafdat, &ordedat, permtab, peritab, NULL, NULL, NULL) != 0) { /* Initialize ordering again */
+  if (SCOTCH_graphOrderInit (&grafdat, &ordedat, permtab, peritab, NULL, NULL, NULL) != 0) { /* Initialize ordering for loading */
     SCOTCH_errorPrint ("main: cannot initialize ordering (2)");
     exit (EXIT_FAILURE);
   }
 
+  rewind (fileptr2);
+  if (SCOTCH_graphOrderLoad (&grafdat, &ordedat, fileptr2) != 0) { /* Test ordering data input routine */
+    SCOTCH_errorPrint ("main: cannot load ordering");
+    exit (EXIT_FAILURE);
+  }
+  fclose (fileptr2);
+
+  if (SCOTCH_graphOrderCheck (&grafdat, &ordedat) != 0) {
+    SCOTCH_errorPrint ("main: invalid ordering (2)");
+    exit (EXIT_FAILURE);
+  }
+
+  checkOrder (baseval, vertnbr, permtab, peritab); /* Double check permutation validity and bijectivity */
+
+  if (memcmp (peritab, peritmp, vertnbr * sizeof (SCOTCH_Num)) != 0) {
+    SCOTCH_errorPrint ("main: loaded ordering differs from saved ordering");
+    exit (EXIT_FAILURE);
+  }
+
+  SCOTCH_graphOrderExit (&grafdat, &ordedat);     /* Free loaded ordering */
+
+  checkOrderLoad (&grafdat, baseval, vertnbr, permtab, peritab, vertnbr + 1, 0, baseval); /* Invalid number of ordering lines */
+  checkOrderLoad (&grafdat, baseval, vertnbr, permtab, peritab, vertnbr, 0, baseval - 1); /* Rank below base value          */
+  checkOrderLoad (&grafdat, baseval, vertnbr, permtab, peritab, vertnbr, 0, baseval + vertnbr); /* Rank above range          */
+  checkOrderLoad (&grafdat, baseval, vertnbr, permtab, peritab, vertnbr, 1, baseval); /* Duplicate rank                     */
+
+  if (SCOTCH_graphOrderInit (&grafdat, &ordedat, permtab, peritab, NULL, NULL, NULL) != 0) { /* Initialize ordering again */
+    SCOTCH_errorPrint ("main: cannot initialize ordering (3)");
+    exit (EXIT_FAILURE);
+  }
+
   if (SCOTCH_graphOrderComputeList (&grafdat, &ordedat, listnbr, listtab, &stradat) != 0) {
     SCOTCH_errorPrint ("main: cannot order induced graph");
     exit (EXIT_FAILURE);
   }
 
   if (SCOTCH_graphOrderCheck (&grafdat, &ordedat) != 0) {
-    SCOTCH_errorPrint ("main: invalid ordering (2)");
+    SCOTCH_errorPrint ("main: invalid ordering (3)");
     exit (EXIT_FAILURE);
   }
 
@@ -233,6 +327,7 @@ char *              argv[])
 

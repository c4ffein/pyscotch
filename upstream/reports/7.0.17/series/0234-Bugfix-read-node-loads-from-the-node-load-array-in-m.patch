+/******************************/
+/*                            */
+/* The mesh building routine. */
+/*                            */
+/******************************/
+
+/* This routine builds a mesh made of a square grid
+** of quadrangle elements. Elements are numbered
+** first, then nodes. Element and node loads are
+** provided according to the flag value. The
+** element load array is placed last in memory,
+** so that reading past its end is noticeable.
+** It returns:
+** - !NULL  : pointer to mesh data, to be freed after the mesh.
+** - NULL   : on error.
+*/
+
+static
+SCOTCH_Num *
+meshBuildGrid (
+SCOTCH_Mesh * const         meshptr,
+const SCOTCH_Num            dimnval,              /*+ Number of elements per side       +*/
+const SCOTCH_Num            baseval,
+const int                   flagval)              /*+ 1: element loads; 2: node loads; 4: unit element loads +*/
+{
+  SCOTCH_Num          velmnbr;
+  SCOTCH_Num          vnodnbr;
+  SCOTCH_Num          velmnum;
+  SCOTCH_Num          vnodnum;
+  SCOTCH_Num          edgenbr;
+  SCOTCH_Num          edgenum;
+  SCOTCH_Num *        datatab;
+  SCOTCH_Num *        verttab;
+  SCOTCH_Num *        velotab;
+  SCOTCH_Num *        vnlotab;
+  SCOTCH_Num *        edgetab;
+  SCOTCH_Num *        enodtab;                    /* Current indices in node edge sub-arrays */
+
+  velmnbr = dimnval * dimnval;
+  vnodnbr = (dimnval + 1) * (dimnval + 1);
+  edgenbr = 8 * velmnbr;                          /* Four element-node edges per element, both ways */
+
+  if ((datatab = malloc ((2 * (velmnbr + vnodnbr) + 1 + edgenbr + vnodnbr) * sizeof (SCOTCH_Num))) == NULL)
+    return (NULL);
+  verttab = datatab;                              /* Compact vertex array for elements and nodes */
+  vnlotab = verttab + (velmnbr + vnodnbr + 1);
+  edgetab = vnlotab + vnodnbr;
+  enodtab = edgetab + edgenbr;
+  velotab = enodtab + vnodnbr;                    /* Element load array is last */
+
+  for (vnodnum = 0; vnodnum < vnodnbr; vnodnum ++) /* Compute node degrees */
+    enodtab[vnodnum] = 0;
+  for (velmnum = 0; velmnum < velmnbr; velmnum ++) {
+    vnodnum = velmnum + (velmnum / dimnval);      /* Number of lower-left node of element */
+    enodtab[vnodnum] ++;
+    enodtab[vnodnum + 1] ++;
+    enodtab[vnodnum + dimnval + 1] ++;
+    enodtab[vnodnum + dimnval + 2] ++;
+  }
+
+  for (velmnum = 0, edgenum = baseval; velmnum < velmnbr; velmnum ++, edgenum += 4) /* Set element edge sub-arrays */
+    verttab[velmnum] = edgenum;
+  for (vnodnum = 0; vnodnum < vnodnbr; vnodnum ++) { /* Set node edge sub-arrays */
+    SCOTCH_Num          degrval;
+
+    degrval = enodtab[vnodnum];
+    verttab[velmnbr + vnodnum] = edgenum;
+    enodtab[vnodnum] = edgenum;                   /* Node sub-arrays will be filled from their start */
+    edgenum += degrval;
+  }
+  verttab[velmnbr + vnodnbr] = edgenum;           /* Set end of compact vertex array */
+
+  for (velmnum = 0; velmnum < velmnbr; velmnum ++) { /* Fill edge array */
+    SCOTCH_Num          vnodtab[4];
+    int                 i;
+
+    vnodnum = velmnum + (velmnum / dimnval);
+    vnodtab[0] = vnodnum;
+    vnodtab[1] = vnodnum + 1;
+    vnodtab[2] = vnodnum + dimnval + 1;
+    vnodtab[3] = vnodnum + dimnval + 2;
+    for (i = 0; i < 4; i ++) {
+      edgetab[verttab[velmnum] - baseval + i] = vnodtab[i] + velmnbr + baseval; /* Node numbers follow element numbers */
+      edgetab[enodtab[vnodtab[i]] ++ - baseval] = velmnum + baseval;
+    }
+  }
+
+  for (velmnum = 0; velmnum < velmnbr; velmnum ++)
+    velotab[velmnum] = ((flagval & 4) != 0) ? 1 : (1 + (velmnum % 3));
+  for (vnodnum = 0; vnodnum < vnodnbr; vnodnum ++)
+    vnlotab[vnodnum] = 1 + (vnodnum % 5);
+
+  if (SCOTCH_meshBuild (meshptr, baseval, baseval + velmnbr, velmnbr, vnodnbr, verttab, verttab + 1,
+                        ((flagval & 1) != 0) ? velotab : NULL, ((flagval & 2) != 0) ? vnlotab : NULL, NULL,
+                        edgenbr, edgetab) != 0) {
+    free (datatab);
+    return (NULL);
+  }
+
+  return (datatab);
+}
+
+/****************************/
+/*                          */
+/* The mesh ordering routine. */
+/*                          */
+/****************************/
+
+/* This routine orders the given mesh with the
+** default strategy and checks the resulting
+** permutations. The inverse permutation is
+** kept in the user-provided array.
+** It exits on error.
+*/
+
+static
+void
+meshOrderTest (
+SCOTCH_Mesh * const         meshptr,
+const SCOTCH_Num            baseval,
+const SCOTCH_Num            vnodnbr,
+SCOTCH_Num * const          peritab,              /*+ Inverse permutation array, of size vnodnbr +*/
+const char * const          nameptr)
+{
+  SCOTCH_Ordering     ordedat;
+  SCOTCH_Strat        stradat;
+  SCOTCH_Num *        permtab;
+  SCOTCH_Num          vnodnum;
+
+  if ((permtab = malloc (vnodnbr * sizeof (SCOTCH_Num))) == NULL) {
+    SCOTCH_errorPrint ("meshOrderTest: out of memory");
+    exit (EXIT_FAILURE);
+  }
+
+  if (SCOTCH_stratInit (&stradat) != 0) {         /* Use default ordering strategy */
+    SCOTCH_errorPrint ("meshOrderTest: cannot initialize strategy");
+    exit (EXIT_FAILURE);
+  }
+
+  if (SCOTCH_meshOrderInit (meshptr, &ordedat, permtab, peritab, NULL, NULL, NULL) != 0) {
+    SCOTCH_errorPrint ("meshOrderTest: cannot initialize ordering");
+    exit (EXIT_FAILURE);
+  }
+
+  SCOTCH_randomReset ();                          /* Make orderings reproducible */
+  if (SCOTCH_meshOrderCompute (meshptr, &ordedat, &stradat) != 0) {
+    SCOTCH_errorPrint ("meshOrderTest: cannot order mesh (%s)", nameptr);
+    exit (EXIT_FAILURE);
+  }
+
+  if (SCOTCH_meshOrderCheck (meshptr, &ordedat) != 0) {
+    SCOTCH_errorPrint ("meshOrderTest: invalid ordering (%s)", nameptr);
+    exit (EXIT_FAILURE);
+  }
+
+  for (vnodnum = 0; vnodnum < vnodnbr; vnodnum ++) { /* Check that permutations are inverse of each other */
+    SCOTCH_Num          permval;
+
+    permval = permtab[vnodnum];
+    if ((permval < baseval) || (permval >= (vnodnbr + baseval)) ||
+        (peritab[permval - baseval] != (vnodnum + baseval))) {
+      SCOTCH_errorPrint ("meshOrderTest: invalid permutation (%s)", nameptr);
+      exit (EXIT_FAILURE);
+    }
+  }
+
+  SCOTCH_meshOrderExit (meshptr, &ordedat);
+  SCOTCH_stratExit     (&stradat);
+  free (permtab);
+}
+
+/* This routine builds a grid mesh, orders it
+** and checks the resulting ordering.
+** It exits on error.
+*/
+
+static
+void
+meshGridTest (
+const SCOTCH_Num            dimnval,              /*+ Number of elements per side       +*/
+const SCOTCH_Num            baseval,
+const int                   flagval,              /*+ 1: element loads; 2: node loads; 4: unit element loads +*/
+SCOTCH_Num * const          peritab,              /*+ Inverse permutation array                              +*/
+const char * const          nameptr)
+{
+  SCOTCH_Mesh         meshdat;
+  SCOTCH_Num *        datatab;
+
+  if (SCOTCH_meshInit (&meshdat) != 0) {
+    SCOTCH_errorPrint ("meshGridTest: cannot initialize mesh");
+    exit (EXIT_FAILURE);
+  }
+
+  if ((datatab = meshBuildGrid (&meshdat, dimnval, baseval, flagval)) == NULL) {
+    SCOTCH_errorPrint ("meshGridTest: cannot build mesh (%s)", nameptr);
+    exit (EXIT_FAILURE);
+  }
+
+  if (SCOTCH_meshCheck (&meshdat) != 0) {
+    SCOTCH_errorPrint ("meshGridTest: invalid mesh (%s)", nameptr);
+    exit (EXIT_FAILURE);
+  }
+
+  meshOrderTest (&meshdat, baseval, (dimnval + 1) * (dimnval + 1), peritab, nameptr);
+
+  SCOTCH_meshExit (&meshdat);
+  free (datatab);
+}
+
+/*********************/
+/*                   */
+/* The main routine. */
+/*                   */
+/*********************/
+
+int
+main (
+int                 argc,
+char *              argv[])
+{
+  SCOTCH_Num *        peritab;
+  SCOTCH_Num *        peritmp;
+
+  SCOTCH_errorProg (argv[0]);
+
+  if (argc != 1) {
+    SCOTCH_errorPrint ("usage: %s", argv[0]);
+    exit (EXIT_FAILURE);
+  }
+
+  if (((peritab = malloc (33 * 33 * sizeof (SCOTCH_Num))) == NULL) ||
+      ((peritmp = malloc (33 * 33 * sizeof (SCOTCH_Num))) == NULL)) {
+    SCOTCH_errorPrint ("main: out of memory");
+    exit (EXIT_FAILURE);
+  }
+
+  meshGridTest (32, 0, 2, peritab, "grid with node loads");
+  meshGridTest (32, 0, 6, peritmp, "grid with node loads and unit element loads");
+  if (memcmp (peritab, peritmp, 33 * 33 * sizeof (SCOTCH_Num)) != 0) { /* Unit element loads must not change ordering */
+    SCOTCH_errorPrint ("main: element load array changes ordering");
+    exit (EXIT_FAILURE);
+  }
+  meshGridTest (32, 1, 3, peritab, "grid with element and node loads");
+  meshGridTest (32, 1, 0, peritab, "grid without loads");
+
+  free (peritmp);
+  free (peritab);
+
+  exit (EXIT_SUCCESS);
+}

 \end{itemize}
diff --git a/src/check/test_libmetis.c b/src/check/test_libmetis.c
index c88dd9a..e587c20 100644
--- a/src/check/test_libmetis.c
+++ b/src/check/test_libmetis.c
@@ -189,6 +189,69 @@ const double * const        twgttab)              /* Interleaved target weights
   free (loadtab);
 }
 
+/* This routine checks that the returned
+** objective value is the edge cut or the
+** communication volume of the produced
+** partition, as requested.
+** It exits on error.
+*/
+
+static
+void
+checkObjval (
+const SCOTCH_Num            baseval,
+const SCOTCH_Num            vertnbr,
+const SCOTCH_Num * const    verttab,
+const SCOTCH_Num * const    edgetab,
+const SCOTCH_Num * const    edlotab,              /* Edge load array, or NULL   */
+const SCOTCH_Num * const    vsiztab,              /* Vertex size array, or NULL */
+const SCOTCH_Num * const    parttab,
+const SCOTCH_Num            partnbr,
+const SCOTCH_Num            objtval,              /* Requested objective type   */
+const SCOTCH_Num            objval)
+{
+  SCOTCH_Num *        nghbtab;                    /* Last vertex found in each part */
+  SCOTCH_Num          vertnum;
+  SCOTCH_Num          edgenum;
+  SCOTCH_Num          cutsum;
+  SCOTCH_Num          volsum;
+
+  if ((nghbtab = malloc (partnbr * sizeof (SCOTCH_Num))) == NULL) {
+    SCOTCH_errorPrint ("checkObjval: out of memory");
+    exit (EXIT_FAILURE);
+  }
+  memset (nghbtab, ~0, partnbr * sizeof (SCOTCH_Num));
+
+  for (vertnum = 0, edgenum = verttab[0] - baseval, cutsum = volsum = 0; /* Un-based traversal */
+       vertnum < vertnbr; vertnum ++) {
+    SCOTCH_Num          edgennd;
+    SCOTCH_Num          partval;
+
+    partval = parttab[vertnum] - baseval;
+    nghbtab[partval] = vertnum;                   /* Do not count own part */
+    for (edgennd = verttab[vertnum + 1] - baseval; edgenum < edgennd; edgenum ++) {
+      SCOTCH_Num          partend;
+
+      partend = parttab[edgetab[edgenum] - baseval] - baseval;
+      if (partend == partval)
+        continue;
+      cutsum += (edlotab != NULL) ? edlotab[edgenum] : 1;
+      if (nghbtab[partend] != vertnum) {          /* If first neighbor in this part */
+        nghbtab[partend] = vertnum;
+        volsum += (vsiztab != NULL) ? vsiztab[vertnum] : 1;
+      }
+    }
+  }
+  cutsum /= 2;                                    /* Each cut edge was seen twice */
+
+  free (nghbtab);
+
+  if (objval != ((objtval == METIS_OBJTYPE_VOL) ? volsum : cutsum)) {
+    SCOTCH_errorPrint ("checkObjval: invalid objective value");
+    exit (EXIT_FAILURE);
+  }
+}
+
 /*********************/
 /*                   */
 /* The main routine. */
@@ -382,6 +445,30 @@ char *              argv[])
 
   checkOrder (baseval, vertnbr, parttab, peritab);
 
+  options[METIS_OPTION_OBJTYPE] = METIS_OBJTYPE_VOL; /* Minimize communication volume, with unit vertex sizes */
+
+  if (SCOTCHMETISNAMEC (METIS_PartGraphKway) (&vertnbr, &nconval, verttab, edgetab, velotab, NULL, edlotab,
+                                              &partnbr, awgttab, kbaltab, options, &edgecut, parttab) != METIS_OK) {
+    SCOTCH_errorPrint ("main: error in METIS_V5_PartGraphKway (5)");
+    exit (EXIT_FAILURE);
+  }
+
+  checkPart   (baseval, vertnbr, parttab, partnbr);
+  checkObjval (baseval, vertnbr, verttab, edgetab, edlotab, NULL, parttab, partnbr, METIS_OBJTYPE_VOL, edgecut);
+
+  options[METIS_OPTION_OBJTYPE] = METIS_OBJTYPE_CUT; /* Minimize edge cut; vertex sizes should be ignored */
+  for (vertnum = 0; vertnum < vertnbr; vertnum ++)
+    peritab[vertnum] = (vertnum % 7) + 1;         /* Use inverse permutation array as vertex size array */
+
+  if (SCOTCHMETISNAMEC (METIS_PartGraphRecursive) (&vertnbr, &nconval, verttab, edgetab, velotab, peritab, edlotab,
+                                                   &partnbr, awgttab, kbaltab, options, &edgecut, parttab) != METIS_OK) {
+    SCOTCH_errorPrint ("main: error in METIS_V5_PartGraphRecursive (3)");
+    exit (EXIT_FAILURE);
+  }
+
+  checkPart   (baseval, vertnbr, parttab, partnbr);
+  checkObjval (baseval, vertnbr, verttab, edgetab, edlotab, peritab, parttab, partnbr, METIS_OBJTYPE_CUT, edgecut);
+
   for (optinum = 0; optinum < METIS_NOPTIONS; optinum ++) /* MeTiS v5 callers fill option arrays with -1 to get default values */
     options[optinum] = -1;
   if (baseval != 0)                               /* Default numbering is from 0 */
diff --git a/src/libscotchmetis/metis_graph_part.c b/src/libscotchmetis/metis_graph_part.c

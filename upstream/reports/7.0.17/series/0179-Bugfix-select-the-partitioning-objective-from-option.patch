 doc/src/scotch/s_l.tex                |  7 ++-
 src/check/test_libmetis.c             | 87 +++++++++++++++++++++++++++
 src/libscotchmetis/metis_graph_part.c | 19 ++++--
 3 files changed, 105 insertions(+), 8 deletions(-)


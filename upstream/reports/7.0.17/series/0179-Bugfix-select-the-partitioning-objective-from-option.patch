+  SCOTCH_Num          objtval;
   double              kbalval;
 
   if (*ncon < 1) {
@@ -594,6 +595,12 @@ const SCOTCH_Num            flagval)
     return (METIS_ERROR_INPUT);
   }
 
+  objtval = _SCOTCH_METIS_optionGet (options, xadj, METIS_OPTION_OBJTYPE, METIS_OBJTYPE_CUT); /* For the Fortran interface, null arrays are those equal to xadj */
+  if ((objtval != METIS_OBJTYPE_CUT) && (objtval != METIS_OBJTYPE_VOL)) {
+    SCOTCH_errorPrint ("_SCOTCH_METIS_V5_PartGraph: invalid objective type option");
+    return (METIS_ERROR_INPUT);
+  }
+
   kbalval = 0.01;                                 /* Default imbalance tolerance */
   if (ubvec != NULL) {                            /* If imbalance ratio array provided; only first constraint is used */
     if (ubvec[0] <= 1.0) {
@@ -603,13 +610,13 @@ const SCOTCH_Num            flagval)
     kbalval = ubvec[0] - 1.0;                     /* Turn MeTiS imbalance ratio into Scotch imbalance tolerance */
   }
 
-  baseval = _SCOTCH_METIS_optionGet (options, xadj, METIS_OPTION_NUMBERING, 0); /* For the Fortran interface, null arrays are those equal to xadj */
+  baseval = _SCOTCH_METIS_optionGet (options, xadj, METIS_OPTION_NUMBERING, 0);
   if ((baseval < 0) || (baseval > 1)) {
     SCOTCH_errorPrint ("_SCOTCH_METIS_V5_PartGraph: invalid numbering option");
     return (METIS_ERROR_INPUT);
   }
 
-  return ((vsize == NULL)
+  return ((objtval == METIS_OBJTYPE_CUT)          /* Edge cut does not use vertex sizes; communication volume does not use edge loads */
           ? _SCOTCH_METIS_PartGraph (nvtxs, ncon, xadj, adjncy, vwgt, adjwgt,
                                      &baseval, nparts, tpwgts, options, objval, part,
                                      flagval, &kbalval)

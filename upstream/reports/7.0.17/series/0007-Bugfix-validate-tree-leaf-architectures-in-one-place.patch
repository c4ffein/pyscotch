+/* This routine builds the labeled tree
+** leaf architecture from its level size,
+** link cost and label permutation arrays.
+** Architecture fields are set only on
+** success.
+** It returns:
+** - 0   : if the architecture has been successfully built.
+** - !0  : on error.
+*/
+
+int
+archLtleafArchBuild (
+ArchTleaf * restrict const  archptr,
+const Anum                  levlnbr,              /*+ Number of levels                            +*/
+const Anum * restrict const sizetab,              /*+ Size array, by increasing level number      +*/
+const Anum * restrict const linktab,              /*+ Link cost array, by increasing level number +*/
+const Anum                  permnbr,              /*+ Number of permutation indices               +*/
+const Anum * restrict const permtab)              /*+ Permutation array                           +*/
+{
+  if (archTleafArchBuild (archptr, levlnbr, sizetab, linktab) != 0) /* Build tree part */
+    return (1);
+
+  if (archLtleafArchBuild2 (archptr, permnbr, permtab) != 0) { /* Build permutation part */
+    archTleafArchFree (archptr);                  /* Free tree part                   */
+    return (1);
+  }
+
+  return (0);
+}

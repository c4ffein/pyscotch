+/* This routine reads the tree structure
+** of a tree leaf architecture into a
+** temporary array, which comprises the
+** level size array followed by the level
+** link cost array.
+** It returns:
+** - 0   : if the tree structure has been successfully read.
+** - !0  : on error.
+*/
+
+static
+int
+archTleafArchLoad2 (
+FILE * restrict const       stream,
+Anum * restrict const       levlptr,              /*+ Number of levels                  +*/
+Anum ** restrict const      sizeptr)              /*+ Pointer to temporary size array   +*/
+{
+  Anum * restrict     sizetab;
+  Anum                levlnbr;
+  Anum                levlnum;
+
+  if ((intLoad (stream, &levlnbr) != 1) ||
+      (levlnbr < 1)                     ||
+      (levlnbr > (Anum) ((sizeof (Anum) << 3) - 2))) { /* Each level at least doubles the number of terminal domains */
+    errorPrint ("archTleafArchLoad2: bad input (1)");
+    return (1);
+  }
+
+  if ((sizetab = memAlloc (levlnbr * 2 * sizeof (Anum))) == NULL) {
+    errorPrint ("archTleafArchLoad2: out of memory");
+    return (1);
+  }
+
+  for (levlnum = 0; levlnum < levlnbr; levlnum ++) {
+    if ((intLoad (stream, &sizetab[levlnum])           != 1) ||
+        (intLoad (stream, &sizetab[levlnbr + levlnum]) != 1)) {
+      errorPrint ("archTleafArchLoad2: bad input (2)");
+      memFree    (sizetab);
+      return (1);
+    }
+  }
+
+  *levlptr = levlnbr;
+  *sizeptr = sizetab;
+
+  return (0);
+}

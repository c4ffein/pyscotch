+/* This routine loads the labeled
+** tree leaf architecture.
+** It returns:
+** - 0   : if the architecture has been successfully read.
+** - !0  : on error.
+*/
+
+int
+archLtleafArchLoad (
+ArchTleaf * restrict const  archptr,
+FILE * restrict const       stream)
+{
+  Anum *              sizetab;                    /* Temporary array of level sizes and link costs */
+  Anum *              permtab;                    /* Temporary permutation array                   */
+  Anum                levlnbr;
+  Anum                permnbr;
+  Anum                permnum;
+  int                 o;
+
+  archptr->sizetab =                              /* Assume nothing allocated yet */
+  archptr->permtab = NULL;
+
+  if (archTleafArchLoad2 (stream, &levlnbr, &sizetab) != 0) /* Read tree structure */
+    return (1);
+
+  o = archTleafArchBuild (archptr, levlnbr, sizetab, sizetab + levlnbr); /* Build tree part */
+  memFree (sizetab);
+  if (o != 0)                                     /* On error, caller will clean up by calling archLtleafArchFree() */
+    return (1);
+
+  if ((intLoad (stream, &permnbr) != 1) ||
+      (permnbr < 1)                     ||
+      (permnbr > archptr->termnbr)) {
+    errorPrint ("archLtleafArchLoad: bad input (1)");
+    return (1);
+  }
+
+  if ((permtab = memAlloc (permnbr * sizeof (Anum))) == NULL) {
+    errorPrint ("archLtleafArchLoad: out of memory");
+    return (1);
+  }
+
+  for (permnum = 0; permnum < permnbr; permnum ++) {
+    if (intLoad (stream, &permtab[permnum]) != 1) {
+      errorPrint ("archLtleafArchLoad: bad input (2)");
+      memFree    (permtab);
+      return (1);
+    }
+  }
+
+  o = archLtleafArchBuild2 (archptr, permnbr, permtab); /* Build permutation part */
+
+  memFree (permtab);
+
+  return (o);
+}

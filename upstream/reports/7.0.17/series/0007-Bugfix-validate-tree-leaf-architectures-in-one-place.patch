+/* This routine builds the tree leaf
+** architecture from its level size and
+** link cost arrays. Architecture fields
+** are set only on success.
+** It returns:
+** - 0   : if the architecture has been successfully built.
+** - !0  : on error.
+*/
+
+int
+archTleafArchBuild (
+ArchTleaf * restrict const  archptr,
+const Anum                  levlnbr,              /*+ Number of levels                            +*/
+const Anum * restrict const sizetab,              /*+ Size array, by increasing level number      +*/
+const Anum * restrict const linktab)              /*+ Link cost array, by increasing level number +*/
+{
+  Anum * restrict     sizetmp;
+  Anum                termnbr;
+  Anum                levlnum;
+
+#ifdef SCOTCH_DEBUG_ARCH1
+  if ((sizeof (ArchTleaf)    > sizeof (ArchDummy)) ||
+      (sizeof (ArchTleafDom) > sizeof (ArchDomDummy))) {
+    errorPrint ("archTleafArchBuild: invalid type specification");
+    return (1);
+  }
+#endif /* SCOTCH_DEBUG_ARCH1 */
+
+  if (levlnbr < 1) {
+    errorPrint ("archTleafArchBuild: invalid number of levels");
+    return (1);
+  }
+  for (levlnum = 0, termnbr = 1; levlnum < levlnbr; levlnum ++) { /* Check level data before allocating */
+    Anum                sizeval;
+
+    sizeval = sizetab[levlnum];
+    if ((sizeval < 2) || (linktab[levlnum] < 1)) {
+      errorPrint ("archTleafArchBuild: invalid level size or link cost");
+      return (1);
+    }
+    if (termnbr > (ANUMMAX / sizeval)) {          /* If number of terminal domains would overflow */
+      errorPrint ("archTleafArchBuild: too many terminal domains");
+      return (1);
+    }
+    termnbr *= sizeval;
+  }
+
+  if ((sizetmp = memAlloc ((levlnbr * 2 + 1) * sizeof (Anum))) == NULL) { /* TRICK: One more slot for linktab[-1] */
+    errorPrint ("archTleafArchBuild: out of memory");
+    return (1);
+  }
+
+  archptr->termnbr     = termnbr;                 /* Set architecture fields only on success */
+  archptr->levlnbr     = levlnbr;
+  archptr->sizetab     = sizetmp;
+  archptr->linktab     = sizetmp + levlnbr + 1;   /* TRICK: One more slot                     */
+  archptr->linktab[-1] = 0;                       /* Dummy slot for level-0 communication     */
+  archptr->permtab     = NULL;                    /* Assume no permutation array              */
+  memCpy (archptr->sizetab, sizetab, levlnbr * sizeof (Anum));
+  memCpy (archptr->linktab, linktab, levlnbr * sizeof (Anum));
+
+  return (0);
+}

 src/check/Makefile              |   9 ++
 src/check/test_common_integer.c | 158 ++++++++++++++++++++++++++++++++
 src/libscotch/common_integer.c  |  18 +---
 4 files changed, 178 insertions(+), 13 deletions(-)

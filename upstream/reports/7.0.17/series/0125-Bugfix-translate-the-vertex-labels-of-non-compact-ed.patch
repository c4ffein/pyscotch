+/************************************************************/
+/**                                                        **/
+/**   NAME       : test_scotch_dgraph_build.c              **/
+/**                                                        **/
+/**   AUTHOR     : Francois PELLEGRINI                     **/
+/**                                                        **/
+/**   FUNCTION   : This module tests the operation of      **/
+/**                the SCOTCH_dgraphBuild() routine when   **/
+/**                vertex labels are provided.             **/
+/**                                                        **/
+/**   DATES      : # Version 7.0  : from : 13 oct 2026     **/
+/**                                 to   : 13 oct 2026     **/
+/**                                                        **/
+/************************************************************/
+
+/*
+**  The defines and includes.
+*/
+
+#include <mpi.h>
+
+#include "../libscotch/module.h"
+#include "../libscotch/common.h"
+
+#include "ptscotch.h"
+
+/*
+**  The type and structure definitions.
+*/
+
+/*+ Test cases. +*/
+
+typedef enum C_TestCase_ {
+  C_TESTVALID = 0,                                /*+ Valid labeled graph with a non-compact edge array +*/
+  C_TESTUNKNOWN,                                  /*+ Some edge refers to a label that does not exist   +*/
+  C_TESTDUPLICATE,                                /*+ Some process has two vertices with the same label +*/
+  C_TESTNBR
+} C_TestCase;
+
+/*********************/
+/*                   */
+/* The main routine. */
+/*                   */
+/*********************/
+
+/* Each process holds two vertices, with labels 100 * (p + 1) + 1
+** and 100 * (p + 1) + 2, so that labels are not contiguous. Each
+** vertex is linked to the other vertex of the same process, and
+** the processes form a ring: the first vertex of each process is
+** linked to the second vertex of the previous process, and the
+** second vertex of each process to the first vertex of the next
+** process. The edge array is not compact: an unused slot, filled
+** with a sentinel value, follows the edges of each vertex.
+*/
+
+int
+main (
+int                 argc,
+char *              argv[])
+{
+  MPI_Comm            proccomm;
+  int                 procglbnbr;                 /* Number of processes sharing graph data */
+  int                 proclocnum;                 /* Number of this process                 */
+  SCOTCH_Dgraph       grafdat;
+  SCOTCH_Num          baseval;
+  C_TestCase          casenum;
+#ifdef SCOTCH_PTHREAD
+  int                 thrdreqlvl;
+  int                 thrdprolvl;
+#endif /* SCOTCH_PTHREAD */
+
+  SCOTCH_errorProg (argv[0]);
+
+#ifdef SCOTCH_PTHREAD
+  thrdreqlvl = MPI_THREAD_MULTIPLE;
+  if (MPI_Init_thread (&argc, &argv, thrdreqlvl, &thrdprolvl) != MPI_SUCCESS) {
+    SCOTCH_errorPrint ("main: Cannot initialize (1)");
+    exit (EXIT_FAILURE);
+  }
+#else /* SCOTCH_PTHREAD */
+  if (MPI_Init (&argc, &argv) != MPI_SUCCESS) {
+    SCOTCH_errorPrint ("main: Cannot initialize (2)");
+    exit (EXIT_FAILURE);
+  }
+#endif /* SCOTCH_PTHREAD */
+
+  if (argc != 1) {
+    SCOTCH_errorPrint ("usage: %s", argv[0]);
+    exit (EXIT_FAILURE);
+  }
+
+  proccomm = MPI_COMM_WORLD;
+  MPI_Comm_size (proccomm, &procglbnbr);          /* Get communicator data */
+  MPI_Comm_rank (proccomm, &proclocnum);
+
+  SCOTCH_randomProc (proclocnum);                 /* Record process number to initialize pseudo-random seed */
+
+#ifdef SCOTCH_CHECK_NOAUTO
+  fprintf (stderr, "Proc %2d of %2d, pid %d\n", proclocnum, procglbnbr, getpid ());
+
+  if (proclocnum == 0) {                          /* Synchronize on keybord input */
+    char           c;
+
+    printf ("Waiting for key press...\n");
+    scanf ("%c", &c);
+  }
+#endif /* SCOTCH_CHECK_NOAUTO */
+
+  if (MPI_Barrier (proccomm) != MPI_SUCCESS) {    /* Synchronize for debug */
+    SCOTCH_errorPrint ("main: cannot communicate (1)");
+    exit (EXIT_FAILURE);
+  }
+
+  for (baseval = 0; baseval <= 1; baseval ++) {
+    for (casenum = C_TESTVALID; casenum < C_TESTNBR; casenum ++) {
+      SCOTCH_Num          vertloctab[2];
+      SCOTCH_Num          vendloctab[2];
+      SCOTCH_Num          vlblloctab[2];
+      SCOTCH_Num          edgeloctab[8];
+      SCOTCH_Num          edgelocnbr;
+      SCOTCH_Num          edgelocnum;
+      SCOTCH_Num          vlblnxtval;             /* First label of next process */
+      int                 cheklocval;
+      int                 chekglbval[2];
+      int                 o;
+
+      vlblloctab[0] = 100 * (proclocnum + 1) + 1;
+      vlblloctab[1] = 100 * (proclocnum + 1) + 2;
+      if ((casenum == C_TESTDUPLICATE) && (proclocnum == 0)) /* Duplicate label on first process */
+        vlblloctab[1] = vlblloctab[0];
+      vlblnxtval = 100 * ((proclocnum + 1) % procglbnbr + 1);
+
+      edgelocnum = baseval;
+      vertloctab[0] = edgelocnum;
+      edgeloctab[edgelocnum ++ - baseval] = vlblloctab[1];
+      if (procglbnbr > 1)
+        edgeloctab[edgelocnum ++ - baseval] = 100 * ((proclocnum + procglbnbr - 1) % procglbnbr + 1) + 2;
+      if ((casenum == C_TESTUNKNOWN) && (proclocnum == (procglbnbr - 1))) /* Unknown label on last process */
+        edgeloctab[edgelocnum ++ - baseval] = 9999;
+      vendloctab[0] = edgelocnum;
+      edgeloctab[edgelocnum ++ - baseval] = -1;   /* Unused slot */
+      vertloctab[1] = edgelocnum;
+      edgeloctab[edgelocnum ++ - baseval] = vlblloctab[0];
+      if (procglbnbr > 1)
+        edgeloctab[edgelocnum ++ - baseval] = vlblnxtval + 1;
+      vendloctab[1] = edgelocnum;
+      edgeloctab[edgelocnum ++ - baseval] = -1;   /* Unused slot */
+      edgelocnbr = (vendloctab[0] - vertloctab[0]) + (vendloctab[1] - vertloctab[1]);
+
+      if (SCOTCH_dgraphInit (&grafdat, proccomm) != 0) { /* Initialize source graph */
+        SCOTCH_errorPrint ("main: cannot initialize graph");
+        exit (EXIT_FAILURE);
+      }
+
+      o = SCOTCH_dgraphBuild (&grafdat, baseval, 2, 2, vertloctab, vendloctab, NULL, vlblloctab,
+                              edgelocnbr, edgelocnum - baseval, edgeloctab, NULL, NULL);
+
+      cheklocval  = o;                            /* All processes must return the same value */
+      chekglbval[0] = chekglbval[1] = 0;
+      if ((MPI_Allreduce (&cheklocval, &chekglbval[0], 1, MPI_INT, MPI_MIN, proccomm) != MPI_SUCCESS) ||
+          (MPI_Allreduce (&cheklocval, &chekglbval[1], 1, MPI_INT, MPI_MAX, proccomm) != MPI_SUCCESS)) {
+        SCOTCH_errorPrint ("main: cannot communicate (2)");
+        exit (EXIT_FAILURE);
+      }
+      if (chekglbval[0] != chekglbval[1]) {
+        SCOTCH_errorPrint ("main: processes disagree on build result (case %d)", (int) casenum);
+        exit (EXIT_FAILURE);
+      }
+
+      if (casenum == C_TESTVALID) {
+        if (o != 0) {
+          SCOTCH_errorPrint ("main: cannot build valid graph (base %d)", (int) baseval);
+          exit (EXIT_FAILURE);
+        }
+        if (SCOTCH_dgraphCheck (&grafdat) != 0) {
+          SCOTCH_errorPrint ("main: invalid built graph (base %d)", (int) baseval);
+          exit (EXIT_FAILURE);
+        }
+        if ((edgeloctab[vendloctab[0] - baseval] != -1) || /* Unused slots must not have been translated */
+            (edgeloctab[vendloctab[1] - baseval] != -1)) {
+          SCOTCH_errorPrint ("main: unused edge slots modified (base %d)", (int) baseval);
+          exit (EXIT_FAILURE);
+        }
+      }
+      else if (o == 0) {
+        SCOTCH_errorPrint ("main: invalid graph accepted (case %d, base %d)", (int) casenum, (int) baseval);
+        exit (EXIT_FAILURE);
+      }
+
+      SCOTCH_dgraphExit (&grafdat);
+    }
+  }
+
+  MPI_Finalize ();
+  exit (EXIT_SUCCESS);
+}

+/* Copyright 2007,2010,2013,2014,2018,2023,2025,2026 IPB, Universite de Bordeaux, INRIA & CNRS
 **
 ** This file is part of the Scotch software package for static mapping,
 ** graph partitioning and sparse matrix ordering.
@@ -389,6 +389,23 @@ const Gnum                  degrlocmax)
       }
     }
 
+    for (vertlocnum = baseval, edsolocptr = edsoloctab, edsoloctnd = edsoloctab + edgelocnbr; /* Edge array may not be compact */
+         vertlocnum < grafptr->vertlocnnd; vertlocnum ++) {
+      Gnum                edgelocnnd;
+
+      edgelocnnd = vendloctax[vertlocnum];
+      if ((edgelocnnd - vertloctax[vertlocnum]) > (edsoloctnd - edsolocptr)) /* If more edges than announced */
+        break;
+      for (edgelocnum = vertloctax[vertlocnum]; edgelocnum < edgelocnnd; edgelocnum ++, edsolocptr ++) {
+        edsolocptr->vlblglbnum = edgeloctax[edgelocnum]; /* Build edge sort array */
+        edsolocptr->edgelocnum = edgelocnum;
+      }
+    }
+    if (edsolocptr != edsoloctnd) {               /* If sum of vertex degrees differs from number of edges */
+      errorPrint ("dgraphBuild3: invalid local number of edges");
+      goto fail;
+    }
+
     cheklocval = 0;                               /* Everything went well */
 fail:
     if (MPI_Allreduce (&cheklocval, &chekglbval, 1, MPI_INT, MPI_MAX, grafptr->proccomm) != MPI_SUCCESS) { /* All processes must agree before exchanging label data */
@@ -401,12 +418,7 @@ fail:
       return (1);
     }
 
-    for (edsolocptr = edsoloctab, edsoloctnd = edsoloctab + edgelocnbr, edgelocnum = baseval;
-         edsolocptr < edsoloctnd; edsolocptr ++, edgelocnum ++) {
-      edsolocptr->vlblglbnum = edgeloctax[edgelocnum];
-      edsolocptr->edgelocnum = edgelocnum;
-    }
-    intSort2asc2 (edsoloctab, grafptr->edgelocnbr);
+    intSort2asc2 (edsoloctab, edgelocnbr);
 
     procrcvnum = (grafptr->proclocnum + 1) % procglbnbr; /* Compute indices of neighbors */
     procsndnum = (grafptr->proclocnum - 1 + procglbnbr) % procglbnbr;
@@ -458,6 +470,15 @@ fail:
 
     if (cheklocval != 0)                          /* If some label was found on several processes */
       errorPrint ("dgraphBuild3: duplicate vertex label (2)");
+    else {
+      for (edsolocptr = edsoloctab; edsolocptr < edsoloctnd; edsolocptr ++) {
+        if (edsolocptr->edgelocnum != -1) {       /* If some edge label was found on no process */
+          errorPrint ("dgraphBuild3: unknown vertex label");
+          cheklocval = 1;
+          break;
+        }
+      }
+    }
 
     memFree (vesongbtab[0]);                      /* Free group leader */
 

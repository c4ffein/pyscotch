 #define EPSILON 1e-6
+#define DOUBADJMAX 1e6                            /* Largest renormalization factor, so that weights fit in integers */
 
 void
 _SCOTCH_METIS_doubleToInt (
@@ -218,11 +219,17 @@ SCOTCH_Num * const          intetab)
     double              doubtmp;
 
     doubval  = doubtab[i];
-    doubval *= doubadj;                         /* See if renormalization factor works        */
-    doubtmp  = doubval - floor (doubval + EPSILON); /* Determine its possible fractional part */
-    if (fabs (doubtmp) >= EPSILON) {            /* If a residual fractional part exists       */
-      doubtmp = doubadj / doubtmp;              /* Incorporate it in renormalization factor   */
-      doubadj = (doubadj * doubtmp) / (double) intGcd ((int) round (doubadj), (int) round (doubtmp));
+    doubval *= doubadj;                           /* See if renormalization factor works        */
+    doubtmp  = doubval - floor (doubval + EPSILON); /* Determine its possible fractional part   */
+    if (fabs (doubtmp) >= EPSILON) {              /* If a residual fractional part exists       */
+      doubtmp = doubadj / doubtmp;                /* Incorporate it in renormalization factor   */
+      if (doubtmp <= DOUBADJMAX)                  /* If factor fits in an integer, reduce it    */
+        doubtmp = (doubadj * doubtmp) / (double) intGcd ((SCOTCH_Num) round (doubadj), (SCOTCH_Num) round (doubtmp));
+      if (doubtmp > DOUBADJMAX) {                 /* If renormalization factor grows too large  */
+        doubadj = DOUBADJMAX;                     /* Settle for a fixed resolution              */
+        break;
+      }
+      doubadj = doubtmp;
     }
   }
   for (i = 0; i < valunbr; i ++)

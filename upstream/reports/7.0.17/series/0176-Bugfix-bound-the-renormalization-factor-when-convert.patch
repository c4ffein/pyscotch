 src/check/test_libparmetis.c              | 11 ++++++++++-
 src/libscotchmetis/metis_graph_part.c     | 21 ++++++++++++++-------
 src/libscotchmetis/parmetis_dgraph_part.c | 13 ++++++++++---
 4 files changed, 45 insertions(+), 13 deletions(-)


+/************************************************************/
+/**                                                        **/
+/**   NAME       : test_mesh_base.c                        **/
+/**                                                        **/
+/**   AUTHOR     : PyScotch project                        **/
+/**                                                        **/
+/**   FUNCTION   : This module tests the operation of      **/
+/**                the meshBase() and hmeshBase()          **/
+/**                routines.                               **/
+/**                                                        **/
+/**   DATES      : # Version 7.0  : from : 13 oct 2026     **/
+/**                                 to   : 13 oct 2026     **/
+/**                                                        **/
+/************************************************************/
+
+/*
+**  The defines and includes.
+*/
+
+#include <stdio.h>
+#if (((defined __STDC_VERSION__) && (__STDC_VERSION__ >= 199901L)) || (defined HAVE_STDINT_H))
+#include <stdint.h>
+#endif /* (((defined __STDC_VERSION__) && (__STDC_VERSION__ >= 199901L)) || (defined HAVE_STDINT_H)) */
+#include <stdlib.h>
+#include <string.h>
+
+#include "../libscotch/module.h"
+#include "../libscotch/common.h"
+#include "../libscotch/graph.h"
+#include "../libscotch/mesh.h"
+#include "../libscotch/hmesh.h"
+
+#include "scotch.h"
+
+/*
+**  The static variables.
+*/
+
+/* Two triangle elements (1, 2) sharing two of
+   their nodes (3, 4, 5, 6), elements first, base 1,
+   with element and node loads.                  */
+
+static SCOTCH_Num           verttab[7]  = { 1, 4, 7, 8, 10, 12, 13 };
+static SCOTCH_Num           velotab[2]  = { 2, 3 };
+static SCOTCH_Num           vnlotab[4]  = { 1, 2, 3, 4 };
+static SCOTCH_Num           edgetab[12] = { 3, 4, 5,  4, 5, 6,  1,  1, 2,  1, 2,  2 };
+
+/*********************/
+/*                   */
+/* The main routine. */
+/*                   */
+/*********************/
+
+int
+main (
+int                 argc,
+char *              argv[])
+{
+  SCOTCH_Mesh         meshdat;
+  Mesh *              meshptr;
+  Hmesh               hmshdat;
+  Gnum                vehdtab[2];                 /* Distinct halo end array for elements */
+  Gnum                vertnum;
+
+  SCOTCH_errorProg (argv[0]);
+
+  if (SCOTCH_meshInit (&meshdat) != 0) {
+    SCOTCH_errorPrint ("main: cannot initialize mesh");
+    exit (EXIT_FAILURE);
+  }
+  if (SCOTCH_meshBuild (&meshdat, 1, 3, 2, 4, verttab, NULL, velotab, vnlotab, NULL, 12, edgetab) != 0) {
+    SCOTCH_errorPrint ("main: cannot build mesh");
+    exit (EXIT_FAILURE);
+  }
+  meshptr = (Mesh *) &meshdat;
+  if (meshCheck (meshptr) != 0) {
+    SCOTCH_errorPrint ("main: invalid mesh (1)");
+    exit (EXIT_FAILURE);
+  }
+
+  if ((meshBase (meshptr, 0) != 1) ||             /* Rebase mesh to 0 and back to 1 */
+      (meshCheck (meshptr) != 0)   ||
+      (meshBase (meshptr, 1) != 0) ||
+      (meshCheck (meshptr) != 0)   ||
+      (meshBase (meshptr, 1) != 1)) {             /* Rebasing to same base is a no-op */
+    SCOTCH_errorPrint ("main: invalid mesh (2)");
+    exit (EXIT_FAILURE);
+  }
+  for (vertnum = 0; vertnum < 4; vertnum ++) {    /* Check that load arrays are back in place */
+    if (((vertnum < 2) && (meshptr->velotax[vertnum + 1] != velotab[vertnum])) ||
+        (meshptr->vnlotax[vertnum + 3] != vnlotab[vertnum])) {
+      SCOTCH_errorPrint ("main: invalid mesh (3)");
+      exit (EXIT_FAILURE);
+    }
+  }
+
+  memSet (&hmshdat, 0, sizeof (Hmesh));           /* Build halo mesh without halo from mesh */
+  hmshdat.m       = *meshptr;
+  hmshdat.vehdtax = hmshdat.m.vendtax;            /* Halo end array is the mesh end array */
+  hmshdat.veihnbr = 0;
+  hmshdat.vnohnbr = hmshdat.m.vnodnbr;
+  hmshdat.vnohnnd = hmshdat.m.vnodnnd;
+  hmshdat.vnhlsum = hmshdat.m.vnlosum;
+  hmshdat.enohnbr = hmshdat.m.edgenbr;
+
+  if ((hmeshCheck (&hmshdat) != 0)   ||
+      (hmeshBase (&hmshdat, 0) != 1) ||
+      (hmeshCheck (&hmshdat) != 0)   ||
+      (hmeshBase (&hmshdat, 1) != 0) ||
+      (hmeshCheck (&hmshdat) != 0)   ||
+      (hmshdat.vehdtax != hmshdat.m.vendtax)) {
+    SCOTCH_errorPrint ("main: invalid halo mesh (1)");
+    exit (EXIT_FAILURE);
+  }
+
+  for (vertnum = hmshdat.m.velmbas; vertnum < hmshdat.m.velmnnd; vertnum ++) /* Use a distinct halo end array */
+    vehdtab[vertnum - hmshdat.m.velmbas] = hmshdat.m.vendtax[vertnum];
+  hmshdat.vehdtax = vehdtab - hmshdat.m.velmbas;
+
+  if ((hmeshCheck (&hmshdat) != 0)   ||
+      (hmeshBase (&hmshdat, 0) != 1) ||
+      (hmeshCheck (&hmshdat) != 0)   ||
+      (hmeshBase (&hmshdat, 1) != 0) ||
+      (hmeshCheck (&hmshdat) != 0)   ||
+      (hmshdat.vehdtax != (vehdtab - hmshdat.m.velmbas))) {
+    SCOTCH_errorPrint ("main: invalid halo mesh (2)");
+    exit (EXIT_FAILURE);
+  }
+  for (vertnum = hmshdat.m.velmbas; vertnum < hmshdat.m.velmnnd; vertnum ++) {
+    if (hmshdat.vehdtax[vertnum] != hmshdat.m.vendtax[vertnum]) {
+      SCOTCH_errorPrint ("main: invalid halo mesh (3)");
+      exit (EXIT_FAILURE);
+    }
+  }
+
+  SCOTCH_meshExit (&meshdat);                     /* Mesh arrays are not freed, as they are user-provided */
+
+  exit (EXIT_SUCCESS);
+}
diff --git a/src/libscotch/hmesh.c b/src/libscotch/hmesh.c
index 4da5d0d..c0267d1 100644
--- a/src/libscotch/hmesh.c
+++ b/src/libscotch/hmesh.c
@@ -1,4 +1,4 @@
-/* Copyright 2004,2007,2023 IPB, Universite de Bordeaux, INRIA & CNRS
+/* Copyright 2004,2007,2023,2026 IPB, Universite de Bordeaux, INRIA & CNRS
 **
 ** This file is part of the Scotch software package for static mapping,
 ** graph partitioning and sparse matrix ordering.
@@ -41,7 +41,7 @@
 /**   DATES      : # Version 4.0  : from : 12 sep 2002     **/
 /**                                 to   : 10 feb 2003     **/
 /**                # Version 7.0  : from : 20 jan 2023     **/
-/**                                 to   : 20 jan 2023     **/
+/**                                 to   : 13 oct 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -103,13 +103,19 @@ const Gnum                  baseval)
   baseold = meshptr->m.baseval;                   /* Record old base value */
   baseadj = baseval - baseold;                    /* Compute adjustment    */
 
-  meshBase (&meshptr->m, baseval);                /* Change base of mesh */
+  if (meshptr->vehdtax == meshptr->m.vendtax) {   /* If halo end array is the mesh end array */
+    meshBase (&meshptr->m, baseval);              /* Change base of mesh, end array included */
+    meshptr->vehdtax = meshptr->m.vendtax;        /* Update aliased array access             */
+  }
+  else {                                          /* Halo end array is distinct */
+    meshBase (&meshptr->m, baseval);              /* Change base of mesh        */
 
-  for (velmnum = meshptr->m.velmbas; velmnum < meshptr->m.velmnnd; velmnum ++)
-    meshptr->vehdtax[velmnum] += baseadj;         /* Change base of array */
+    meshptr->vehdtax -= baseadj;                  /* Adjust array access before using new element range */
+    for (velmnum = meshptr->m.velmbas; velmnum < meshptr->m.velmnnd; velmnum ++)
+      meshptr->vehdtax[velmnum] += baseadj;       /* Change base of array */
+  }
 
   meshptr->vnohnnd += baseadj;
-  meshptr->vehdtax -= baseadj;
 
   return (baseold);                               /* Return old base value */
 }

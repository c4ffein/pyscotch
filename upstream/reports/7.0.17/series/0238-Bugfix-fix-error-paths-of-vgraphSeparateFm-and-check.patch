+/**                                 to   : 13 oct 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -351,7 +351,8 @@ const VmeshSeparateFmParam * restrict const paraptr) /*+ Method parameters    +*
     VmeshSeparateGgParam  paramdat;
 
     paramdat.passnbr = 3;
-    vmeshSeparateGg (meshptr, &paramdat);         /* Compute a balanced initial partition */
+    if (vmeshSeparateGg (meshptr, &paramdat) != 0) /* Compute a balanced initial partition */
+      return (1);
   }
 
   vertnbr = meshptr->m.velmnbr + meshptr->m.vnodnbr;

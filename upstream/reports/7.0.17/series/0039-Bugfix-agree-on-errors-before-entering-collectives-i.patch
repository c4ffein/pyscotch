-  if ((Gnum) isndcntnbr != sendcntnbr) {
-    errorPrint ("commGatherv: communication indices out of range (2)");
-    goto fail;
+  if (MPI_Allreduce (&cheklocval, &chekglbval, 1, MPI_INT, MPI_MAX, comm) != MPI_SUCCESS) { /* Agree on error before entering collective communication */
+    errorPrint ("commGatherv: communication error (1)");

-/**                                 to   : 06 oct 2026     **/
+/**                                 to   : 13 oct 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -77,10 +77,13 @@ const Gnum * const          recvdsptab,
 MPI_Datatype                recvtypval,
 MPI_Comm                    comm)
 {
+  int                 isndcntnbr;
   int * restrict      ircvcnttab;
   int * restrict      ircvdsptab;
   int                 procglbnbr;
   int                 procnum;
+  int                 cheklocval;
+  int                 chekglbval;
   int                 o;
 
   if (sizeof (Gnum) == sizeof (int))              /* If no integer size issue, directly call the MPI routine */
@@ -89,28 +92,45 @@ MPI_Comm                    comm)
                             recvtypval, comm));
 
   MPI_Comm_size (comm, &procglbnbr);
-  if (memAllocGroup ((void **) (void *)
-                     &ircvcnttab, (size_t) (procglbnbr * sizeof (int)),
-                     &ircvdsptab, (size_t) (procglbnbr * sizeof (int)), NULL) == NULL) {
+
+  ircvcnttab = NULL;
+  cheklocval = MPI_SUCCESS;                       /* Assume everything is all right */
+
+  isndcntnbr = (int) sendcntnbr;
+  if ((Gnum) isndcntnbr != sendcntnbr) {
+    errorPrint ("commAllgatherv: communication indices out of range (1)");
+    cheklocval = MPI_ERR_ARG;
+  }
+  else if (memAllocGroup ((void **) (void *)
+                          &ircvcnttab, (size_t) (procglbnbr * sizeof (int)),
+                          &ircvdsptab, (size_t) (procglbnbr * sizeof (int)), NULL) == NULL) {
     errorPrint ("commAllgatherv: out of memory");
-    return     (MPI_ERR_OTHER);
+    cheklocval = MPI_ERR_OTHER;
   }
-
-  for (procnum = 0; procnum < procglbnbr; procnum ++) {
-    ircvcnttab[procnum] = (int) recvcnttab[procnum];
-    ircvdsptab[procnum] = (int) recvdsptab[procnum];
-    if (((Gnum) ircvcnttab[procnum] != recvcnttab[procnum]) ||
-        ((Gnum) ircvdsptab[procnum] != recvdsptab[procnum])) {
-      errorPrint ("commAllgatherv: communication indices out of range");
-      memFree    (ircvcnttab);
-      return     (MPI_ERR_ARG);
+  else {
+    for (procnum = 0; procnum < procglbnbr; procnum ++) {
+      ircvcnttab[procnum] = (int) recvcnttab[procnum];
+      ircvdsptab[procnum] = (int) recvdsptab[procnum];
+      if (((Gnum) ircvcnttab[procnum] != recvcnttab[procnum]) ||
+          ((Gnum) ircvdsptab[procnum] != recvdsptab[procnum])) {
+        errorPrint ("commAllgatherv: communication indices out of range (2)");
+        cheklocval = MPI_ERR_ARG;
+        break;
+      }
     }
   }
 
-  o = MPI_Allgatherv (senddattab, sendcntnbr, sendtypval,
-                      recvdattab, ircvcnttab, ircvdsptab, recvtypval, comm);
+  if (MPI_Allreduce (&cheklocval, &chekglbval, 1, MPI_INT, MPI_MAX, comm) != MPI_SUCCESS) { /* Agree on error before entering collective communication */
+    errorPrint ("commAllgatherv: communication error (1)");
+    chekglbval = MPI_ERR_OTHER;
+  }
+  o = (chekglbval == MPI_SUCCESS)
+      ? MPI_Allgatherv (senddattab, isndcntnbr, sendtypval,
+                        recvdattab, ircvcnttab, ircvdsptab, recvtypval, comm)
+      : chekglbval;
 
-  memFree (ircvcnttab);
+  if (ircvcnttab != NULL)
+    memFree (ircvcnttab);
 
   return (o);
 }
@@ -135,6 +155,8 @@ MPI_Comm                    comm)
   int * restrict      ircvcnttab;
   int * restrict      ircvdsptab;
   int                 proclocnum;
+  int                 cheklocval;
+  int                 chekglbval;
   int                 o;
 
   if (sizeof (Gnum) == sizeof (int))              /* If no integer size issue, directly call the MPI routine */
@@ -145,9 +167,14 @@ MPI_Comm                    comm)
   MPI_Comm_rank (comm, &proclocnum);
 
   ircvcnttab = NULL;
-  o = MPI_ERR_ARG;                                /* Assume a parameter overflow error */
+  cheklocval = MPI_SUCCESS;                       /* Assume everything is all right */
 

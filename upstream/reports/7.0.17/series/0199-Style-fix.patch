From e6b662ec77cce05755f47f46367f906469e3f303 Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 16:08:12 +0000
Subject: [PATCH 199/240] Style fix

---
 src/scotch/atst.c   | 4 ++--
 src/scotch/gout_o.c | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/scotch/atst.c b/src/scotch/atst.c
index 54a53c7..ce46ce0 100644
--- a/src/scotch/atst.c
+++ b/src/scotch/atst.c
@@ -182,7 +182,7 @@ char *                      argv[])
   for (ter0num = 0; ter0num < termnbr; ter0num ++) { /* For all pairs of terminal domains */
     for (ter1num = 0; ter1num < termnbr; ter1num ++) {
       if (ter1num == ter0num)
-	continue;
+        continue;
 
       distdlt += fabs ((double) SCOTCH_archDomDist (&archdat, &termtab[ter0num], &termtab[ter1num]) - distavg);
     }
@@ -225,7 +225,7 @@ SCOTCH_ArchDom * const          domnptr)
   if (SCOTCH_archDomSize (archptr, domnptr) == 1) { /* If domain is terminal */
     if (*termptr >= termnum)                      /* If too many terminals   */
       return (1);
-   
+
     termtab[(*termptr) ++] = *domnptr;            /* Copy terminal domain to array */
     return (0);
   }
diff --git a/src/scotch/gout_o.c b/src/scotch/gout_o.c
index f32d264..ced9a98 100644
--- a/src/scotch/gout_o.c
+++ b/src/scotch/gout_o.c
@@ -243,7 +243,7 @@ FILE * const                fileptr)              /* Output stream   */
     case O_OUTTYPETULMESH :                       /* Mesh Tulip output type */
       outDrawTulMesh (grafptr, geomptr, mappptr, fileptr);
       break;
-    case O_OUTTYPEVTKMESH :                       /* Mesh Tulip output type */
+    case O_OUTTYPEVTKMESH :                       /* Mesh VTK output type */
       outDrawVtkMesh (grafptr, geomptr, mappptr, fileptr);
       break;
     default :
@@ -1174,7 +1174,7 @@ FILE * const                fileptr)              /* Output stream
            pathnbr,
            indxnbr);
   for (indxnum = 0; indxnum < indxnbr; ) {
-    SCOTCH_Num          pontnbr;                  /* Number of points in current segment */    
+    SCOTCH_Num          pontnbr;                  /* Number of points in current segment */
     SCOTCH_Num          indxtmp;
 
     pontnbr = indxtab[indxnum];
-- 

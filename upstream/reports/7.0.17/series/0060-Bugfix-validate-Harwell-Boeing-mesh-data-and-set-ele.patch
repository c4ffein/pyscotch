From df260befb5ecbe6f491006092af621b9fa505bcc Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 13:04:30 +0000
Subject: [PATCH 060/240] Bugfix: validate Harwell-Boeing mesh data and set
 element load sum [report R. Perry]

`meshGeomLoadHabo()` checked the ELTPTR and VARIND values read from the
file only under `SCOTCH_DEBUG_MESH2`, so a malformed file indexed
`verttax` and `edgetax` out of bounds (and the debug checks returned
without freeing the mesh). It never set `velosum`, so `meshCheck()`
rejected every loaded mesh. Negative header counts were used as array
sizes and vertex bases, and a huge field width in the format line made
the fixed-width reader loop on EOF for as many characters.

Check the header counts and field widths, check every ELTPTR value
(bounds and monotonicity) and every VARIND value unconditionally, stop
reading a field at end of file, set `velosum` and remove the debug
check made redundant. Add a three-element matrix to the test data,
which `mcv` converts and `mtst` checks.

Refs: SEP-08, PS2-G11-mesh-struct-io-6
---
 src/check/CMakeLists.txt     |  5 +++++
 src/check/Makefile           |  3 +++
 src/check/data/hb3.msh       | 10 ++++++++++
 src/check/data/hb3.pue       |  6 ++++++
 src/libscotch/mesh_io_habo.c | 27 ++++++++++++++-------------
 5 files changed, 38 insertions(+), 13 deletions(-)
 create mode 100644 src/check/data/hb3.msh
 create mode 100644 src/check/data/hb3.pue

diff --git a/src/check/CMakeLists.txt b/src/check/CMakeLists.txt
index f62f413..92e8bc5 100644
--- a/src/check/CMakeLists.txt
+++ b/src/check/CMakeLists.txt
@@ -581,6 +581,11 @@ endforeach()
 
 add_test(NAME mtst_small2_lbl COMMAND mtst ${dat}/small2_lbl.msh)
 
+add_test(NAME mcv_pue_hb3 COMMAND ${BASH} -c
+  "'$<TARGET_FILE:mcv>' '${dat}/hb3.pue' output_hb3.msh -ib -os && \
+   '${CMAKE_COMMAND}' -E compare_files '${dat}/hb3.msh' output_hb3.msh && \
+   '$<TARGET_FILE:mtst>' output_hb3.msh")
+
 # check_prog_mord
 
 foreach(mmk_msh m2_5_1 m2_5_4 m3_5_4_3)
diff --git a/src/check/Makefile b/src/check/Makefile
index f7ec6ec..4c34cbc 100644
--- a/src/check/Makefile
+++ b/src/check/Makefile
@@ -735,6 +735,9 @@ check_prog_mcv		        :	check_prog_mmk
 					$(PROGDIFF) $(TMPDIR)/m2_5_4.msh $(TMPDIR)/output_m2_5_4.msh
 					$(PROGDIFF) $(TMPDIR)/m2_5_4_3.msh $(TMPDIR)/output_m2_5_4_3.msh
 					$(EXECS) $(SCOTCHBINDIR)/mtst data/small2_lbl.msh
+					$(EXECS) $(SCOTCHBINDIR)/mcv data/hb3.pue $(TMPDIR)/output_hb3.msh -ib -os
+					$(PROGDIFF) data/hb3.msh $(TMPDIR)/output_hb3.msh
+					$(EXECS) $(SCOTCHBINDIR)/mtst $(TMPDIR)/output_hb3.msh
 
 
 check_prog_mord                 :	check_prog_gmk_msh

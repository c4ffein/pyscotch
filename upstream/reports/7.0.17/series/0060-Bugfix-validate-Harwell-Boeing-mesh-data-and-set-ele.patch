+3	2	3	4
+3	1	3	4
diff --git a/src/check/data/hb3.pue b/src/check/data/hb3.pue
new file mode 100644
index 0000000..96271e2
--- /dev/null
+++ b/src/check/data/hb3.pue
@@ -0,0 +1,6 @@
+Three triangle elements on four nodes                                   HB3ELT
+             2             1             1             0             0
+PUE                        4             3             9             0
+(4I3)           (9I3)
+  1  4  7 10
+  1  2  3  2  3  4  1  3  4
diff --git a/src/libscotch/mesh_io_habo.c b/src/libscotch/mesh_io_habo.c
index 0846d4e..2a5b940 100644
--- a/src/libscotch/mesh_io_habo.c
+++ b/src/libscotch/mesh_io_habo.c
@@ -164,6 +164,11 @@ const char * const          dataptr)              /* Tag value        */
     errorPrint ("meshGeomLoadHabo: rectangular matrices not supported");
     return (1);
   }
+  if ((habvarnbr < 0) || (habeltnbr < 0) || (habvixnbr < 0) || /* Header values are used as array sizes and bases */
+      (habcolsiz < 1) || (habnzrsiz < 1)) {
+    errorPrint ("meshGeomLoadHabo: bad input (11)");
+    return (1);
+  }
 
   if (((meshptr->verttax = (Gnum *) memAlloc ((habeltnbr + habvarnbr + 1) * sizeof (Gnum))) == NULL) ||
       ((meshptr->edgetax = (Gnum *) memAlloc (habvixnbr * 2               * sizeof (Gnum))) == NULL)) {
@@ -188,6 +193,7 @@ const char * const          dataptr)              /* Tag value        */
   meshptr->vnodbas = 1;
   meshptr->vnodnnd = meshptr->velmbas;
   meshptr->vnlosum = habvarnbr;
+  meshptr->velosum = habeltnbr;                   /* Elements and nodes are not weighted */
 
   for (velmnum = meshptr->velmbas; velmnum <= meshptr->velmnnd; velmnum ++) { /* Read ELTPTR as second part of vertex array */
     Gnum              habcolval;                  /* Current column value                                                   */
@@ -195,7 +201,7 @@ const char * const          dataptr)              /* Tag value        */
 
     while (((c = getc (filesrcptr)) == '\n') || (c == '\r')) ;
     habcolval = (c == ' ') ? 0 : (c - '0');
-    for (habcolidx = 1; habcolidx < habcolsiz; habcolidx ++) {
+    for (habcolidx = 1; (habcolidx < habcolsiz) && (c != EOF); habcolidx ++) { /* Stop at end of file, whatever the field width */
       if ((c = getc (filesrcptr)) != ' ')
         habcolval = habcolval * 10 + c - '0';
     }
@@ -204,12 +210,12 @@ const char * const          dataptr)              /* Tag value        */
       meshFree   (meshptr);
       return (1);
     }
-#ifdef SCOTCH_DEBUG_MESH2
-    if ((habcolval < 1) || (habcolval > (habvixnbr + 1))) {
+    if ((habcolval < 1) || (habcolval > (habvixnbr + 1)) || /* ELTPTR values must be within bounds and non-decreasing */
+        ((velmnum > meshptr->velmbas) && ((habcolval + habvixnbr) < meshptr->verttax[velmnum - 1]))) {
       errorPrint ("meshGeomLoadHabo: bad input (7)");
+      meshFree   (meshptr);
       return (1);
     }
-#endif /* SCOTCH_DEBUG_MESH2 */
 
     meshptr->verttax[velmnum] = habcolval + habvixnbr;
   }
@@ -227,7 +233,7 @@ const char * const          dataptr)              /* Tag value        */
 
     while (((c = getc (filesrcptr)) == '\n') || (c == '\r')) ;
     habnodval = (c == ' ') ? 0 : (c - '0');
-    for (habnzridx = 1; habnzridx < habnzrsiz; habnzridx ++) {
+    for (habnzridx = 1; (habnzridx < habnzrsiz) && (c != EOF); habnzridx ++) { /* Stop at end of file, whatever the field width */
       if ((c = getc (filesrcptr)) != ' ')
         habnodval = habnodval * 10 + c - '0';
     }
@@ -236,12 +242,11 @@ const char * const          dataptr)              /* Tag value        */
       meshFree   (meshptr);
       return (1);
     }
-#ifdef SCOTCH_DEBUG_MESH2
-    if ((habnodval < 1) || (habnodval > habvarnbr)) {
+    if ((habnodval < 1) || (habnodval > habvarnbr)) { /* VARIND values must be valid node numbers (also rejects blank fields) */
       errorPrint ("meshGeomLoadHabo: bad input (10)");
+      meshFree   (meshptr);
       return (1);
     }
-#endif /* SCOTCH_DEBUG_MESH2 */
     meshptr->edgetax[edgenum] = habnodval;
     meshptr->verttax[habnodval] ++;
   }
@@ -274,12 +279,8 @@ const char * const          dataptr)              /* Tag value        */
 
       vnodnum = meshptr->edgetax[edgenum];
 #ifdef SCOTCH_DEBUG_MESH2
-      if ((vnodnum < 1) || (vnodnum > habvarnbr)) {
-        errorPrint ("meshGeomLoadHabo: internal error (2)");
-        return (1);
-      }
       if (meshptr->verttax[vnodnum] > habvixnbr) {
-        errorPrint ("meshGeomLoadHabo: internal error (3)");
+        errorPrint ("meshGeomLoadHabo: internal error (2)");
         return (1);
       }
 #endif /* SCOTCH_DEBUG_MESH2 */

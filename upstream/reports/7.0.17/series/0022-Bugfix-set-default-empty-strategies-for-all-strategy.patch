 /**                                 to   : 28 sep 2014     **/
 /**                # Version 7.0  : from : 17 jan 2023     **/
-/**                                 to   : 08 oct 2026     **/
+/**                                 to   : 13 oct 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -81,7 +81,7 @@ static Bdgraph              bdgraphdummy;     /* Dummy distributed bipartitioned
 static union {
   BdgraphBipartBdParam      param;
   StratNodeMethodData       padding;
-} bdgraphbipartstdefaultbd = { { 3, &stratdummy } };
+} bdgraphbipartstdefaultbd = { { 3, &stratdummy, &stratdummy } };
 
 static union {
   BdgraphBipartDfParam      param;
diff --git a/src/libscotch/bgraph_bipart_st.c b/src/libscotch/bgraph_bipart_st.c

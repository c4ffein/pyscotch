 /*                   */
 /* The main routine. */
@@ -174,7 +221,13 @@ char *              argv[])
   const double        awgttab[9] = { 0.10, 0.10, 0.05, 0.10, 0.20, 0.30, 0.05, 0.05, 0.05 };
   const double        bwgttab[9] = { 0.123457, 0.098765, 0.111111, 0.087654, 0.145678, 0.133333, 0.100001, 0.099999, 0.100002 }; /* Part weights without a small common denominator */
   const SCOTCH_Num    nconval = 1;
-  const double        kbaltab[1] = { 0.05 };
+  const double        kbaltab[1] = { 1.05 };      /* MeTiS imbalance ratios are greater than 1.0 */
+  const SCOTCH_Num    ncontwo = 2;
+  const double        kbaltwo[2] = { 1.05, 1.05 };
+  double              awgttwo[18];
+  SCOTCH_Num *        velotwo;
+  SCOTCH_Num          partnum;
+  SCOTCH_Num          vertnum;
   SCOTCH_Num          options[METIS_NOPTIONS];
 #endif /* (SCOTCH_METIS_VERSION == 5) */
 
@@ -289,6 +342,38 @@ char *              argv[])
 
   checkPart (baseval, vertnbr, parttab, partnbr);
 
+  if (SCOTCHMETISNAMEC (METIS_PartGraphRecursive) (&vertnbr, &nconval, verttab, edgetab, velotab, NULL, edlotab,
+                                                   &partnbr, NULL, NULL, options, &edgecut, parttab) != METIS_OK) { /* No part weights nor imbalance ratio */
+    SCOTCH_errorPrint ("main: error in METIS_V5_PartGraphRecursive (2)");
+    exit (EXIT_FAILURE);
+  }
+
+  checkPart (baseval, vertnbr, parttab, partnbr);
+
+  if ((velotwo = malloc (vertnbr * 2 * sizeof (SCOTCH_Num))) == NULL) { /* Two interleaved vertex constraints */
+    SCOTCH_errorPrint ("main: out of memory (2)");
+    exit (EXIT_FAILURE);
+  }
+  for (vertnum = 0; vertnum < vertnbr; vertnum ++) {
+    velotwo[2 * vertnum]     = (velotab != NULL) ? velotab[vertnum] : 1; /* First constraint is the vertex load */
+    velotwo[2 * vertnum + 1] = vertnum + 1;       /* Second constraint should be ignored */
+  }
+  for (partnum = 0; partnum < partnbr; partnum ++) {
+    awgttwo[2 * partnum]     = awgttab[partnum];
+    awgttwo[2 * partnum + 1] = 1.0 / (double) partnbr;
+  }
+
+  if (SCOTCHMETISNAMEC (METIS_PartGraphKway) (&vertnbr, &ncontwo, verttab, edgetab, velotwo, NULL, edlotab,
+                                              &partnbr, awgttwo, kbaltwo, options, &edgecut, parttab) != METIS_OK) {
+    SCOTCH_errorPrint ("main: error in METIS_V5_PartGraphKway (3)");
+    exit (EXIT_FAILURE);
+  }
+
+  checkPart (baseval, vertnbr, parttab, partnbr);
+  checkLoad (baseval, vertnbr, velotwo, ncontwo, parttab, partnbr, awgttwo);
+
+  free (velotwo);
+
   if (SCOTCHMETISNAMEC (METIS_NodeND) (&vertnbr, verttab, edgetab, velotab, options, peritab, parttab) != METIS_OK) {
     SCOTCH_errorPrint ("main: error in METIS_V5_NodeND");
     exit (EXIT_FAILURE);

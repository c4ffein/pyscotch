+/* This routine checks that the produced
+** partition respects the target weights
+** of the first vertex constraint, within
+** a loose tolerance.
+** It exits on error.
+*/
+
+static
+void
+checkLoad (
+const SCOTCH_Num            baseval,
+const SCOTCH_Num            vertnbr,
+const SCOTCH_Num * const    velotab,              /* Interleaved vertex loads   */
+const SCOTCH_Num            nconval,
+const SCOTCH_Num * const    parttab,
+const SCOTCH_Num            partnbr,
+const double * const        twgttab)              /* Interleaved target weights */
+{
+  double *            loadtab;
+  double              loadsum;
+  SCOTCH_Num          vertnum;
+  SCOTCH_Num          partnum;
+
+  if ((loadtab = malloc (partnbr * sizeof (double))) == NULL) {
+    SCOTCH_errorPrint ("checkLoad: out of memory");
+    exit (EXIT_FAILURE);
+  }
+  memset (loadtab, 0, partnbr * sizeof (double));
+
+  for (vertnum = 0, loadsum = 0.0; vertnum < vertnbr; vertnum ++) { /* Un-based traversal */
+    double              veloval;
+
+    veloval  = (double) velotab[vertnum * nconval]; /* Only first constraint is considered */
+    loadsum += veloval;
+    loadtab[parttab[vertnum] - baseval] += veloval;
+  }
+
+  for (partnum = 0; partnum < partnbr; partnum ++) {
+    if (loadtab[partnum] > (1.5 * loadsum * twgttab[partnum * nconval])) {
+      SCOTCH_errorPrint ("checkLoad: invalid part load");
+      exit (EXIT_FAILURE);
+    }
+  }
+
+  free (loadtab);
+}
+

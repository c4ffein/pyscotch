   veexval  =                                      /* Assume no external gains */
   veexval1 = 0;
@@ -254,13 +267,13 @@ BgraphBipartDfData * restrict const loopptr)
     ielstax[vertnum] = 1.0F / (float) (edlosum + veexval - 2 * veexval1); /* Add absolute value of veexval */
   }
   if (veextax != NULL) {

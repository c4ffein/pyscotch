+      memFree (ielstax);
+    return;
   }
   if (thrdnum == 0)                               /* Thread 0 will write directly in frontab */
     frontab = grafptr->frontab;
 
   ielstax -= vertbas;                             /* Base access to local part of edge load sum array */

+          thrdptr->abrtnum = passnum;             /* Threads will halt at end of pass; record pass number to tell faster threads from slower ones */
+          vertnum = vancnnt - 1;                  /* Skip remaining computations of run but synchronize; last value of run will be overwritten    */
         }
 

-    if (ielstax != NULL)                          /* Free local array if necessary  */
-      memFree (ielstax + vertbas);
+  if (loopptr->abrtval != 0) {                    /* If any process decided to quit */
+    memFree (ielstax + vertbas);                  /* Free local array               */

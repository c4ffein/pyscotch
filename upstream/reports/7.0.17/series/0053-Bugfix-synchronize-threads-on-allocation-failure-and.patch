-    loopptr->thrdtab[thrdnum].veexsum1 = veexsum1;
+    thrdptr->veexsum  = veexsum;
+    thrdptr->veexsum1 = veexsum1;
 #ifndef BGRAPHBIPARTDFNOTHREAD

+          threadReduce (descptr, thrdptr, sizeof (BgraphBipartDfThread), (ThreadReduceFunc) bgraphBipartDfReduceVanc, thrdlst, NULL);
 #endif /* BGRAPHBIPARTDFNOTHREAD */
         }
       }
@@ -377,7 +388,7 @@ skip:
         break;
 
       vancnnt ++;                                 /* Prepare to go only for one more run, to be done twice */
-      vancval = loopptr->vanctab[vertnum - vancnnd] + loopptr->thrdtab[thrdnum].vanctab[vertnum - vancnnd]; /* Load variable with anchor value */
+      vancval = loopptr->vanctab[vertnum - vancnnd] + thrdptr->vanctab[vertnum - vancnnd]; /* Load variable with anchor value */
     }
 
     difttax = (float *) difntax;                  /* Swap old and new diffusion arrays          */
@@ -388,7 +399,11 @@ skip:
     threadBarrier (descptr);
 #endif /* BGRAPHBIPARTDFNOTHREAD */
 
-    if (loopptr->abrtval == 1) {                  /* If all threads need to abort       */
+    for (thrdtmp = 0; thrdtmp < thrdnbr; thrdtmp ++) { /* Check whether some thread overflowed during this pass */
+      if (loopptr->thrdtab[thrdtmp].abrtnum == passnum) /* Faster threads may already have overflowed in next pass */
+        break;
+    }
+    if (thrdtmp < thrdnbr) {                      /* If all threads need to abort       */
       difotax = difntax;                          /* Roll-back to keep last valid array */
       break;
     }
@@ -438,19 +453,19 @@ skip:
     if (commload != 0)                            /* If end vertex is in the other part */

+      fileCompress2 (compptr);                    /* Perform compression                                   */
+      _exit (EXIT_SUCCESS);                       /* Exit without flushing stdio buffers inherited from father */
+    default :                                     /* We are the father process                             */
+      close (pipetab[0]);                         /* Close the reader pipe end                             */
   }
 #endif /* COMMON_PTHREAD_FILE */
 

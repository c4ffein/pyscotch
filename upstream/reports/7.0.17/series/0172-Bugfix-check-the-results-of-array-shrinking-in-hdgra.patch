From b206ae8af552efc150b31272ff373beff5fa0e2b Mon Sep 17 00:00:00 2001
From: PyScotch <pyscotch@noreply.invalid>
Date: Tue, 13 Oct 2026 16:17:53 +0000
Subject: [PATCH 172/240] Bugfix: check the results of array shrinking in
 `hdgraphInduceList()`, `hgraphInduce2()` and `kdgraphMapRbPartSequ()` [report
 PyScotch]

The edge arrays of induced halo graphs and the domain array of
sequential mapping fragments are shrunk to their final size with
`memRealloc()`, whose result was stored without being tested. Should
shrinking fail, the graph or the fragment would point to a
non-existent array: in `hdgraphInduceList()`, the NULL edge array
was dereferenced by `hdgraphFold2()`.

Keep the original arrays, which are valid and large enough, when
shrinking fails, as `dgraphInduce2()` does.

Refs: PS2-G18-1
---
 src/libscotch/hdgraph_induce.c      |  8 ++++----
 src/libscotch/hgraph_induce.c       | 22 ++++++++++++----------
 src/libscotch/kdgraph_map_rb_part.c |  8 +++++---
 3 files changed, 21 insertions(+), 17 deletions(-)

diff --git a/src/libscotch/hdgraph_induce.c b/src/libscotch/hdgraph_induce.c
index b2e6d83..3601ffc 100644
--- a/src/libscotch/hdgraph_induce.c
+++ b/src/libscotch/hdgraph_induce.c
@@ -43,7 +43,7 @@
 /**                # Version 5.1  : from : 27 jun 2008     **/
 /**                                 to   : 22 oct 2010     **/
 /**                # Version 7.0  : from : 28 aug 2019     **/
-/**                                 to   : 04 oct 2026     **/
+/**                                 to   : 13 oct 2026     **/
 /**                                                        **/
 /************************************************************/
 
@@ -100,6 +100,7 @@ Hdgraph * restrict const    indgrafptr)
   Gnum                  indvelolocsum;            /* Sum of vertex loads                            */
   Gnum                  indvhallocnum;            /* Number of halo vertex to be declared           */
   Gnum * restrict       indedgeloctax;
+  Gnum *                indedgeloctmp;            /* Pointer to shrunk edge array, if any           */
   Gnum                  indedgelocmax;            /* (Approximate) number of edges in induced graph */
   Gnum                  indedgelocsiz;            /* Real size of edge array, including halo        */
   Gnum                  indedgelocnbr;            /* Real number of edges in induced graph          */
@@ -299,9 +300,8 @@ fail2:
   indvertloctax[indvertlocnum] = indedgelocnum;   /* Mark end of edge array for vhndloctax                 */
   indedgelocsiz = indedgelocnum - orggrafptr->s.baseval; /* Global number of edges, both non-halo and halo */
 
-  indgrafptr->s.edgeloctax = memRealloc (indgrafptr->s.edgeloctax + orggrafptr->s.baseval,
-                                         (size_t) (indedgelocsiz * sizeof (Gnum)));
-  indgrafptr->s.edgeloctax -= orggrafptr->s.baseval;
+  if ((indedgeloctmp = memRealloc (indgrafptr->s.edgeloctax + orggrafptr->s.baseval, (size_t) (indedgelocsiz * sizeof (Gnum)))) != NULL) /* Shrink edge array and delete index arrays; keep them as is if shrinking fails */
+    indgrafptr->s.edgeloctax = indedgeloctmp - orggrafptr->s.baseval;
 
   if (orggrafptr->s.vnumloctax != NULL) {         /* Adjust vnumloctax */
     for (indvertlocnum = orggrafptr->s.baseval; indvertlocnum < indvertlocnnd; indvertlocnum ++)

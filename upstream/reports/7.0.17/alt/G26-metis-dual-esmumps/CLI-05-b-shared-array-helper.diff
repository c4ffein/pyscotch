+/* This routine returns the given optional array,
+** or NULL if it is not provided. For the Fortran
+** interface, null arrays are those equal to the
+** given reference array.
+** It returns:
+** - x  : the array pointer, or NULL.
+*/
+
+const SCOTCH_Num *
+_SCOTCH_METIS_arrayGet (
+const SCOTCH_Num * const    arraptr,              /*+ Optional array, or NULL                       +*/
+const SCOTCH_Num * const    nulltab)              /*+ Array that stands for a null array in Fortran +*/
+{
+  return (((arraptr == NULL) || (arraptr == nulltab)) ? NULL : arraptr);
+}

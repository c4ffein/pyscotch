+/* These routines search the format tables
+** for the given format code.
+** They return:
+** - >= 0  : index of format in table.
+** - -1    : if code not found.
+*/
+
+static
+int
+C_inpFormatFind (
+const char                  codeval)
+{
+  int                 j;
+
+  for (j = 0; C_inpFormatTab[j].code != '\0'; j ++) {
+    if (C_inpFormatTab[j].code == codeval)
+      return (j);
+  }
+  return (-1);
+}
+
+static
+int
+C_outFormatFind (
+const char                  codeval)
+{
+  int                 j;
+
+  for (j = 0; C_outFormatTab[j].code != '\0'; j ++) {
+    if (C_outFormatTab[j].code == codeval)
+      return (j);
+  }
+  return (-1);
+}
+

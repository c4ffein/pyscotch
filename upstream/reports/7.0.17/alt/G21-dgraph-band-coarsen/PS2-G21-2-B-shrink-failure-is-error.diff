     }
   }
 
-  coargrafptr->edgeloctax  = memRealloc (coargrafptr->edgeloctax + coargrafptr->baseval, coargrafptr->edgelocsiz * sizeof (Gnum));
+  if (((coargrafptr->edgeloctax = memRealloc (coargrafptr->edgeloctax + coargrafptr->baseval, coargrafptr->edgelocsiz * sizeof (Gnum))) == NULL) ||
+      ((coargrafptr->edloloctax = memRealloc (coargrafptr->edloloctax + coargrafptr->baseval, coargrafptr->edgelocsiz * sizeof (Gnum))) == NULL)) {
+    errorPrint ("dgraphCoarsenBuild: out of memory (3)");
+    dgraphFree (coargrafptr);                     /* Edge load array may be leaked; must be agreed upon before the final reduction */
+    return (1);
+  }
   coargrafptr->edgeloctax -= coargrafptr->baseval;
-  coargrafptr->edloloctax  = memRealloc (coargrafptr->edloloctax + coargrafptr->baseval, coargrafptr->edgelocsiz * sizeof (Gnum));

+# Read the list of C source files of a library from the object list of
+# its Makefile, so that both build systems share a single source list.
+function(makefile_sources var makefile listname)
+  file(READ ${makefile} contents)
+  string(REPLACE "\\\n" " " contents "${contents}")
+  string(REGEX MATCH "\n${listname}[ \t]*=[^\n]*" objlist "${contents}")
+  string(REGEX MATCHALL "[a-z0-9_]+[$][(]OBJ[)]" objects "${objlist}")
+  set(sources)
+  foreach(object IN LISTS objects)
+    string(REGEX REPLACE "[$][(]OBJ[)]$" ".c" source ${object})
+    list(APPEND sources ${source})
+  endforeach()
+  set(${var} ${sources} PARENT_SCOPE)
+endfunction()
+
+makefile_sources(SCOTCH_C_SOURCES ${CMAKE_CURRENT_SOURCE_DIR}/Makefile LIBSCOTCHDEPS)
+list(TRANSFORM SCOTCH_C_SOURCES REPLACE "^parser_(ll|yy)\\.c$" "${CMAKE_CURRENT_BINARY_DIR}/parser_\\1.c")
+list(APPEND SCOTCH_C_SOURCES ${CMAKE_CURRENT_BINARY_DIR}/parser_ly.h ${GENERATED_INCLUDE_DIR}/scotch.h)
 
 add_library(scotch
   ${SCOTCH_C_SOURCES})

diff --git a/cmake/Modules/ConcatFiles.cmake b/cmake/Modules/ConcatFiles.cmake
new file mode 100644
index 0000000..d2ca210
--- /dev/null
+++ b/cmake/Modules/ConcatFiles.cmake
@@ -0,0 +1,14 @@
+# Concatenate files into OUTPUT (replacement for "cmake -E cat", CMake >= 3.18).
+# Usage: cmake -DOUTPUT=<file> -P ConcatFiles.cmake -- <file>...
+
+file(WRITE "${OUTPUT}" "")
+set(inputs OFF)
+math(EXPR argmax "${CMAKE_ARGC} - 1")
+foreach(argnum RANGE ${argmax})
+  if(inputs)
+    file(READ "${CMAKE_ARGV${argnum}}" contents)
+    file(APPEND "${OUTPUT}" "${contents}")
+  elseif(CMAKE_ARGV${argnum} STREQUAL "--")
+    set(inputs ON)
+  endif()
+endforeach()

diff --git a/src/libscotch/CMakeLists.txt b/src/libscotch/CMakeLists.txt
index f67caea..87d7da6 100644
--- a/src/libscotch/CMakeLists.txt
+++ b/src/libscotch/CMakeLists.txt
@@ -515,6 +515,7 @@ set(SCOTCH_C_SOURCES
 add_library(scotch
   ${SCOTCH_C_SOURCES})
 add_library(SCOTCH::scotch ALIAS scotch)

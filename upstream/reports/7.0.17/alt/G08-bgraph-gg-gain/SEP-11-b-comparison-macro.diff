+/*+ Partition comparison: tells whether a partition
+    of communication load cm and imbalance cd is
+    better than one of load bcm and imbalance bcd. +*/
+
+#define BGRAPHBIPARTGGBETTER(cm,cd,bcm,bcd) (((cm) < (bcm)) || (((cm) == (bcm)) && (ABS (cd) < ABS (bcd))))

   for (permnum = 0; permnum < tgtarchdatptr->permnbr; permnum ++)
+    tgtarchdatptr->peritab[permnum] = ~0;         /* Detect duplicate indices */
+  for (permnum = 0; permnum < tgtarchdatptr->permnbr; permnum ++) {

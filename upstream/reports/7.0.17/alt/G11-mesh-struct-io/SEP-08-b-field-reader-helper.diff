 #include "graph.h"
 #include "mesh.h"
 
+/* This routine reads a fixed-width integer
+** field and checks that its value lies in
+** the given range.
+** It returns:
+** - 0   : on success.
+** - !0  : on end of file or out-of-range value.
+*/
+
+static
+int
+meshGeomLoadHaboInt (
+FILE * const                stream,               /* Stream to read from */
+const int                   fldsiz,               /* Width of field      */
+const Gnum                  valmin,               /* Minimum valid value */
+const Gnum                  valmax,               /* Maximum valid value */
+Gnum * const                valptr)               /* Value to return     */
+{
+  Gnum                valval;
+  int                 fldidx;
+  int                 c;
+
+  while (((c = getc (stream)) == '\n') || (c == '\r')) ;
+  valval = (c == ' ') ? 0 : (c - '0');
+  for (fldidx = 1; (fldidx < fldsiz) && (c != EOF); fldidx ++) {
+    if ((c = getc (stream)) != ' ')
+      valval = valval * 10 + c - '0';
+  }
+  if ((c == EOF) || (valval < valmin) || (valval > valmax))
+    return (1);
+
+  *valptr = valval;
+  return (0);
+}
+
